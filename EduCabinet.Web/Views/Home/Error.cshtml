@{
    ViewData["Title"] = "Ошибка";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8 text-center">
        <div class="display-3 text-warning mb-3">
            <i class="bi bi-exclamation-triangle"></i>
        </div>
        <h3 class="fw-bold">Произошла ошибка при обработке запроса</h3>
        @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage as string))
        {
            <div class="alert alert-danger text-start mt-4 p-3 font-mono small" style="word-break: break-all;">
                <div class="fw-bold mb-1">Маршрут запроса: @ViewBag.ErrorPath</div>
                <div class="fw-bold mb-2">Сообщение: @ViewBag.ErrorMessage</div>
                <pre class="small text-muted mb-0" style="max-height: 250px; overflow-y: auto;">@ViewBag.ErrorDetails</pre>
            </div>
        }
        else
        {
            <p class="text-muted">Пожалуйста, вернитесь на главную страницу или обратитесь к администратору.</p>
        }
        <div class="mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-house me-1"></i> На главную
            </a>
        </div>
    </div>
</div>

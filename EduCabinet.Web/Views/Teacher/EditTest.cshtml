@model TestEditViewModel
@{
    ViewData["Title"] = "Настройки теста: " + Model.Title;
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Disciplines">Дисциплины</a></li>
        <li class="breadcrumb-item"><a asp-action="LectureDetails" asp-route-id="@Model.LectureId">@Model.LectureTitle</a></li>
        <li class="breadcrumb-item active" aria-current="page">Настройки теста</li>
    </ol>
</nav>

<div class="row g-4">
    <!-- Левая колонка: параметры теста -->
    <div class="col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-header py-3 border-bottom">
                <h5 class="fw-bold mb-0 text-primary"><i class="bi bi-sliders me-2"></i>Параметры тестирования</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="EditTest" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="LectureId" />
                    <input type="hidden" asp-for="LectureTitle" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Название теста</label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Инструкция для студента</label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-6 mb-3">
                            <label asp-for="PassingScorePercent" class="form-label fw-semibold">Проходной балл (%)</label>
                            <div class="input-group">
                                <input asp-for="PassingScorePercent" type="number" class="form-control" min="1" max="100" />
                                <span class="input-group-text">%</span>
                            </div>
                        </div>
                        <div class="col-6 mb-3">
                            <label asp-for="MaxAttempts" class="form-label fw-semibold">Лимит попыток</label>
                            <input asp-for="MaxAttempts" type="number" class="form-control" min="1" max="20" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="TimeLimitMinutes" class="form-label fw-semibold">Лимит времени (минут)</label>
                        <input asp-for="TimeLimitMinutes" type="number" class="form-control" min="0" max="180" placeholder="0 = без ограничения" />
                        <div class="form-text small">При истечении таймера ответы студента отправляются автоматически.</div>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="ShuffleQuestions" class="form-check-input" />
                        <label asp-for="ShuffleQuestions" class="form-check-label small fw-semibold">
                            Перемешивать порядок вопросов при каждой попытке
                        </label>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="ShuffleOptions" class="form-check-input" />
                        <label asp-for="ShuffleOptions" class="form-check-label small fw-semibold">
                            Перемешивать варианты ответов
                        </label>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label small fw-semibold">
                            Тест активен (доступен для сдачи)
                        </label>
                    </div>

                    <div class="d-flex justify-content-between align-items-center border-top pt-3">
                        <a asp-action="LectureDetails" asp-route-id="@Model.LectureId" class="btn btn-outline-secondary btn-sm">К лекции</a>
                        <div class="d-flex gap-2">
                            <a asp-action="PreviewTest" asp-route-id="@Model.Id" class="btn btn-outline-info btn-sm">
                                <i class="bi bi-eye me-1"></i> Предпросмотр
                            </a>
                            <button type="submit" class="btn btn-primary btn-sm px-3">
                                <i class="bi bi-check2 me-1"></i> Сохранить
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Правая колонка: вопросы теста -->
    <div class="col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-header py-3 border-bottom d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold mb-0 text-primary"><i class="bi bi-patch-question me-2"></i>Вопросы теста</h5>
                    <div class="text-muted small">Всего вопросов в базе: @Model.Questions.Count</div>
                </div>
                <a asp-action="CreateTestQuestion" asp-route-testId="@Model.Id" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-circle me-1"></i> Добавить вопрос
                </a>
            </div>

            <div class="list-group list-group-flush">
                @if (!Model.Questions.Any())
                {
                    <div class="p-4 text-center text-muted">
                        В тесте пока нет вопросов. Добавьте хотя бы один вопрос, чтобы тест мог проводиться.
                    </div>
                }
                @foreach (var q in Model.Questions.OrderBy(q => q.OrderIndex))
                {
                    <div class="list-group-item p-3">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge bg-secondary">#@q.OrderIndex</span>
                                    <span class="badge bg-light text-body border">@q.Type</span>
                                    <span class="badge bg-info-subtle text-info border">Балл: @q.Points</span>
                                </div>
                                <div class="fw-semibold">@q.Text</div>
                                <div class="small text-muted mt-1">Вариантов/элементов: @q.OptionsCount</div>
                            </div>

                            <form asp-action="DeleteTestQuestion" asp-route-id="@q.Id" method="post" onsubmit="return confirm('Удалить вопрос из теста?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Удалить вопрос">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

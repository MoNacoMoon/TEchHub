@model LectureEditViewModel
@{
    ViewData["Title"] = "Редактирование лекции";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-sm border-0">
            <div class="card-header py-3 border-bottom">
                <h4 class="fw-bold mb-0 text-primary"><i class="bi bi-pencil-square me-2"></i>Редактирование лекции</h4>
                <div class="text-muted small">Тема: @Model.TopicTitle</div>
            </div>
            <div class="card-body p-4">
                <form asp-action="EditLecture" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="TopicId" />
                    <input type="hidden" asp-for="TopicTitle" />
                    <input type="hidden" asp-for="DisciplineId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small"></div>

                    <div class="row">
                        <div class="col-md-9 mb-3">
                            <label asp-for="Title" class="form-label fw-semibold">Название лекции</label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="OrderIndex" class="form-label fw-semibold">Порядковый №</label>
                            <input asp-for="OrderIndex" type="number" class="form-control" />
                            <span asp-validation-for="OrderIndex" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Краткое описание / аннотация</label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="AttachmentFile" class="form-label fw-semibold">
                            <i class="bi bi-paperclip me-1 text-primary"></i>Заменить файл материала (PDF, DOCX)
                        </label>

                        @if (!string.IsNullOrEmpty(Model.ExistingAttachmentName))
                        {
                            <div class="p-2 mb-2 bg-light border rounded small d-flex align-items-center justify-content-between">
                                <span><i class="bi bi-file-earmark-check text-success me-1"></i>Текущий файл: <strong>@Model.ExistingAttachmentName</strong></span>
                                <a href="@Model.ExistingAttachmentPath" target="_blank" class="btn btn-sm btn-outline-primary">Просмотреть</a>
                            </div>
                        }

                        <input asp-for="AttachmentFile" type="file" class="form-control" accept=".pdf,.doc,.docx" />
                        <div class="form-text small">Загрузите новый файл, если требуется заменить или обновить материал лекции.</div>
                        <span asp-validation-for="AttachmentFile" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ContentHtml" class="form-label fw-semibold">Теоретический материал (HTML/текст)</label>
                        <textarea asp-for="ContentHtml" class="form-control font-monospace" rows="12"></textarea>
                        <span asp-validation-for="ContentHtml" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 form-check bg-light p-3 rounded border">
                        <input asp-for="RequiresManualReview" class="form-check-input ms-1 me-2" />
                        <label asp-for="RequiresManualReview" class="form-check-label fw-semibold">
                            Требовать ручную проверку развёрнутых ответов до открытия следующей лекции
                        </label>
                    </div>

                    <!-- Блок сдачи отчетов студентами -->
                    <div class="mb-4 bg-light p-3 rounded border">
                        <div class="form-check form-switch mb-2">
                            <input asp-for="RequiresReportSubmission" class="form-check-input" type="checkbox" id="requiresReportSwitch" />
                            <label class="form-check-label fw-bold text-dark" for="requiresReportSwitch">
                                <i class="bi bi-file-earmark-arrow-up text-primary me-1"></i> Требовать сдачу отчёта / практической работы студентом
                            </label>
                        </div>
                        <div class="text-muted small mb-3">
                            Если включено, студент обязан прикрепить свой файл (лабораторная работа, отчет, проект) для проверки. Следующая лекция откроется только после того, как преподаватель поставит оценку и статус «Зачтено».
                        </div>

                        <div id="reportSettingsBlock" style="display: @(Model.RequiresReportSubmission ? "block" : "none");">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="ReportInstructions" class="form-label fw-semibold">Инструкции и требования к отчету</label>
                                    <textarea asp-for="ReportInstructions" class="form-control" rows="3" placeholder="Укажите задание для студента (например: прикрепить отчет в формате DOCX/PDF по ГОСТу, приложить расчеты или архив с кодом)..."></textarea>
                                    <span asp-validation-for="ReportInstructions" class="text-danger small"></span>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="MaxReportScore" class="form-label fw-semibold">Максимальный балл</label>
                                    <input asp-for="MaxReportScore" type="number" class="form-control" min="1" max="1000" />
                                    <span asp-validation-for="MaxReportScore" class="text-danger small"></span>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="ReportDeadline" class="form-label fw-semibold">
                                        <i class="bi bi-clock-history text-danger me-1"></i>Дедлайн сдачи
                                    </label>
                                    <input asp-for="ReportDeadline" type="datetime-local" class="form-control" />
                                    <div class="form-text small text-muted">Необязательно. Если указан, студенты увидят таймер.</div>
                                    <span asp-validation-for="ReportDeadline" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center border-top pt-3">
                        <a asp-action="LectureDetails" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Отмена</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check2 me-1"></i> Сохранить изменения
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const sw = document.getElementById('requiresReportSwitch');
            const blk = document.getElementById('reportSettingsBlock');
            if (sw && blk) {
                sw.addEventListener('change', function () {
                    blk.style.display = this.checked ? 'block' : 'none';
                });
            }
        });
    </script>
}

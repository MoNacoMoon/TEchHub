@model QuestionCreateEditViewModel
@{
    ViewData["Title"] = "Добавление контрольного вопроса";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header py-3 border-bottom">
                <h4 class="fw-bold mb-0 text-primary"><i class="bi bi-patch-question me-2"></i>Новый контрольный вопрос</h4>
                <div class="text-muted small">Лекция: @Model.LectureTitle</div>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateControlQuestion" method="post" enctype="multipart/form-data" id="qForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="LectureId" />
                    <input type="hidden" asp-for="LectureTitle" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small"></div>

                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label asp-for="Type" class="form-label fw-semibold">Тип контрольного вопроса</label>
                            <select asp-for="Type" class="form-select" id="typeSelect" onchange="switchQuestionType()">
                                <option value="SingleChoice">Выбор одного правильного ответа</option>
                                <option value="MultipleChoice">Выбор нескольких правильных ответов</option>
                                <option value="ShortText">Краткий текстовый ответ (автопроверка)</option>
                                <option value="FillBlank">Ввод пропущенного слова или термина</option>
                                <option value="Matching">На установление соответствия</option>
                                <option value="OpenEnded">Развернутый ответ (ручная проверка преподавателем)</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="OrderIndex" class="form-label fw-semibold">Порядковый №</label>
                            <input asp-for="OrderIndex" type="number" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Text" class="form-label fw-semibold">Текст вопроса или задания</label>
                        <textarea asp-for="Text" class="form-control" rows="3" placeholder="Введите формулировку вопроса..." autofocus></textarea>
                        <span asp-validation-for="Text" class="text-danger small"></span>
                    </div>

                    <!-- Блок прикрепления изображения (в стиле TestPad) -->
                    <div class="card bg-light border mb-3">
                        <div class="card-header bg-transparent py-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <span class="fw-semibold small text-body">
                                <i class="bi bi-image text-primary me-1"></i>Изображение к вопросу
                            </span>
                            <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 small" onclick="toggleCtrlUrlInput()">
                                <i class="bi bi-link-45deg"></i> <span id="toggleCtrlUrlText">Указать ссылку (URL)</span>
                            </button>
                        </div>
                        <div class="card-body p-3">
                            <input type="file" asp-for="ImageFile" id="ctrlImageFileInput" accept="image/*" class="d-none" onchange="handleCtrlImageFileSelected(this)" />
                            <input type="hidden" asp-for="RemoveImage" id="ctrlRemoveImageFlag" value="false" />

                            <div id="ctrlImageDropZone" class="testpad-dropzone p-3 text-center border border-2 border-dashed rounded-3 cursor-pointer bg-white" onclick="document.getElementById('ctrlImageFileInput').click()">
                                <i class="bi bi-cloud-arrow-up fs-2 text-primary d-block mb-1"></i>
                                <div class="fw-bold small mb-1">Нажмите для выбора файла или перетащите изображение сюда</div>
                                <div class="text-muted small" style="font-size: 0.75rem;">PNG, JPG, JPEG, GIF, WebP, SVG (до 15 МБ) | Или нажмите Ctrl+V</div>
                            </div>

                            <div id="ctrlImageUrlContainer" class="mt-2" style="display: none;">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text"><i class="bi bi-globe"></i></span>
                                    <input asp-for="ImageUrl" id="ctrlImageUrlInput" class="form-control" placeholder="https://... или /uploads/..." oninput="handleCtrlImageUrlInput(this.value)" />
                                </div>
                            </div>

                            <div id="ctrlImagePreviewContainer" class="mt-3 p-2 bg-white rounded border text-center" style="@(string.IsNullOrEmpty(Model.ImageUrl) ? "display: none;" : "")">
                                <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                                    <span class="badge bg-success-subtle text-success border border-success-subtle" id="ctrlImagePreviewBadge">
                                        <i class="bi bi-check2-circle me-1"></i>Изображение прикреплено
                                    </span>
                                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" onclick="removeCtrlQuestionImage()">
                                        <i class="bi bi-trash3 me-1"></i>Удалить
                                    </button>
                                </div>
                                <img id="ctrlImagePreviewElement" src="@(Model.ImageUrl ?? "")" alt="Превью" class="img-fluid rounded border shadow-sm" style="max-height: 250px; object-fit: contain;" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Explanation" class="form-label fw-semibold">Подсказка / комментарий (необязательно)</label>
                        <input asp-for="Explanation" class="form-control" placeholder="Пояснение для студента после ответа..." />
                    </div>

                    <!-- 1. Блок для ShortText и FillBlank -->
                    <div id="blockTextAnswer" class="p-3 bg-light rounded border mb-3" style="display: none;">
                        <h6 class="fw-bold mb-2">Эталон правильного ответа:</h6>
                        <div class="mb-2">
                            <label asp-for="CorrectTextAnswer" class="form-label small">Правильный ответ (основной)</label>
                            <input asp-for="CorrectTextAnswer" class="form-control" placeholder="Например: Отладка" />
                        </div>
                        <div>
                            <label asp-for="SynonymsCsv" class="form-label small">Допустимые синонимы и варианты написания (через запятую)</label>
                            <input asp-for="SynonymsCsv" class="form-control" placeholder="отладка, дебаг, debugging" />
                            <div class="form-text small">Проверка выполняется без учета регистра и крайних пробелов. Буквы «е» и «ё» считаются эквивалентными.</div>
                        </div>
                    </div>

                    <!-- 2. Блок вариантов ответов (Single / Multiple / Matching) -->
                    <div id="blockOptions" class="p-3 bg-light rounded border mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold mb-0" id="optionsHeader">Варианты ответов:</h6>
                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addOptionRow()">
                                <i class="bi bi-plus-circle me-1"></i> Добавить вариант
                            </button>
                        </div>

                        <div id="optionsContainer">
                            <div class="row g-2 mb-2 option-row align-items-center">
                                <div class="col-auto">
                                    <input type="checkbox" name="Options[0].IsCorrect" value="true" class="form-check-input correct-cb" title="Отметить как правильный" />
                                </div>
                                <div class="col">
                                    <input type="text" name="Options[0].Text" class="form-control form-control-sm" placeholder="Текст варианта 1" value="Вариант 1" />
                                </div>
                                <div class="col matching-target-col" style="display: none;">
                                    <input type="text" name="Options[0].MatchingKey" class="form-control form-control-sm" placeholder="Соответствие (правая часть)" />
                                </div>
                            </div>
                            <div class="row g-2 mb-2 option-row align-items-center">
                                <div class="col-auto">
                                    <input type="checkbox" name="Options[1].IsCorrect" value="true" class="form-check-input correct-cb" title="Отметить как правильный" />
                                </div>
                                <div class="col">
                                    <input type="text" name="Options[1].Text" class="form-control form-control-sm" placeholder="Текст варианта 2" value="Вариант 2" />
                                </div>
                                <div class="col matching-target-col" style="display: none;">
                                    <input type="text" name="Options[1].MatchingKey" class="form-control form-control-sm" placeholder="Соответствие (правая часть)" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Блок для OpenEnded -->
                    <div id="blockOpenEnded" class="alert alert-warning mb-3" style="display: none;">
                        <i class="bi bi-info-circle-fill me-1"></i> Этот вопрос предполагает развернутый текстовый ответ студента. Ответ поступит на страницу «Проверка ответов», где вы сможете оценить его качество и оставить рецензию.
                    </div>

                    <div class="d-flex justify-content-between align-items-center border-top pt-3">
                        <a asp-action="LectureDetails" asp-route-id="@Model.LectureId" class="btn btn-outline-secondary">Отмена</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check2 me-1"></i> Сохранить вопрос
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let optionIndex = 2;

        function switchQuestionType() {
            const type = document.getElementById("typeSelect").value;
            const blockText = document.getElementById("blockTextAnswer");
            const blockOptions = document.getElementById("blockOptions");
            const blockOpenEnded = document.getElementById("blockOpenEnded");
            const matchingCols = document.querySelectorAll(".matching-target-col");
            const correctCbs = document.querySelectorAll(".correct-cb");

            if (type === "ShortText" || type === "FillBlank") {
                blockText.style.display = "block";
                blockOptions.style.display = "none";
                blockOpenEnded.style.display = "none";
            } else if (type === "OpenEnded") {
                blockText.style.display = "none";
                blockOptions.style.display = "none";
                blockOpenEnded.style.display = "block";
            } else if (type === "Matching") {
                blockText.style.display = "none";
                blockOptions.style.display = "block";
                blockOpenEnded.style.display = "none";
                matchingCols.forEach(c => c.style.display = "block");
                correctCbs.forEach(cb => cb.parentElement.style.display = "none");
            } else {
                blockText.style.display = "none";
                blockOptions.style.display = "block";
                blockOpenEnded.style.display = "none";
                matchingCols.forEach(c => c.style.display = "none");
                correctCbs.forEach(cb => cb.parentElement.style.display = "block");
            }
        }

        function addOptionRow() {
            const container = document.getElementById("optionsContainer");
            const type = document.getElementById("typeSelect").value;
            const isMatching = type === "Matching";

            const div = document.createElement("div");
            div.className = "row g-2 mb-2 option-row align-items-center";
            div.innerHTML = `
                <div class="col-auto" style="${isMatching ? 'display:none;' : ''}">
                    <input type="checkbox" name="Options[${optionIndex}].IsCorrect" value="true" class="form-check-input correct-cb" title="Отметить как правильный" />
                </div>
                <div class="col">
                    <input type="text" name="Options[${optionIndex}].Text" class="form-control form-control-sm" placeholder="Текст варианта ${optionIndex + 1}" />
                </div>
                <div class="col matching-target-col" style="${isMatching ? 'display:block;' : 'display:none;'}">
                    <input type="text" name="Options[${optionIndex}].MatchingKey" class="form-control form-control-sm" placeholder="Соответствие (правая часть)" />
                </div>
            `;
            container.appendChild(div);
            optionIndex++;
        }

        function toggleCtrlUrlInput() {
            const container = document.getElementById("ctrlImageUrlContainer");
            const btnText = document.getElementById("toggleCtrlUrlText");
            if (container.style.display === "none") {
                container.style.display = "block";
                btnText.innerText = "Скрыть ссылку";
                document.getElementById("ctrlImageUrlInput").focus();
            } else {
                container.style.display = "none";
                btnText.innerText = "Указать ссылку (URL)";
            }
        }

        function handleCtrlImageFileSelected(input) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                const reader = new FileReader();
                reader.onload = function(e) {
                    showCtrlPreview(e.target.result, file.name);
                };
                reader.readAsDataURL(file);
                document.getElementById("ctrlRemoveImageFlag").value = "false";
            }
        }

        function handleCtrlImageUrlInput(url) {
            if (url && url.trim().length > 0) {
                showCtrlPreview(url.trim(), "По внешней ссылке");
                document.getElementById("ctrlRemoveImageFlag").value = "false";
            } else {
                if (!document.getElementById("ctrlImageFileInput").files.length) {
                    hideCtrlPreview();
                }
            }
        }

        function showCtrlPreview(src, label) {
            const previewContainer = document.getElementById("ctrlImagePreviewContainer");
            const previewElement = document.getElementById("ctrlImagePreviewElement");
            const badge = document.getElementById("ctrlImagePreviewBadge");
            previewElement.src = src;
            if (label) badge.innerHTML = `<i class="bi bi-check2-circle me-1"></i>${label}`;
            previewContainer.style.display = "block";
        }

        function hideCtrlPreview() {
            const previewContainer = document.getElementById("ctrlImagePreviewContainer");
            const previewElement = document.getElementById("ctrlImagePreviewElement");
            previewElement.src = "";
            previewContainer.style.display = "none";
        }

        function removeCtrlQuestionImage() {
            document.getElementById("ctrlImageFileInput").value = "";
            const urlInput = document.getElementById("ctrlImageUrlInput");
            if (urlInput) urlInput.value = "";
            document.getElementById("ctrlRemoveImageFlag").value = "true";
            hideCtrlPreview();
        }

        // Инициализация отображения
        switchQuestionType();
    </script>
}

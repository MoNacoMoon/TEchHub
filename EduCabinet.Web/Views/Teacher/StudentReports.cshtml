@model TeacherReportsViewModel
@{
    ViewData["Title"] = "Проверка отчётов студентов";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-folder-check text-primary me-2"></i>Проверка отчётов студентов
        </h2>
        <p class="text-muted mb-0">Сданные лабораторные, расчетно-графические и практические работы студентов</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="StudentReports" asp-route-status="1" class="btn btn-sm @(Model.SelectedStatus == ReportSubmissionStatus.Pending ? "btn-warning text-dark" : "btn-outline-warning text-dark")">
            <i class="bi bi-hourglass-split me-1"></i> На проверке <span class="badge bg-dark text-white ms-1">@Model.PendingCount</span>
        </a>
        <a asp-action="StudentReports" asp-route-status="2" class="btn btn-sm @(Model.SelectedStatus == ReportSubmissionStatus.Approved ? "btn-success" : "btn-outline-success")">
            <i class="bi bi-check-circle me-1"></i> Зачтено <span class="badge bg-light text-dark ms-1">@Model.ApprovedCount</span>
        </a>
        <a asp-action="StudentReports" asp-route-status="3" class="btn btn-sm @(Model.SelectedStatus == ReportSubmissionStatus.NeedsRevision ? "btn-danger" : "btn-outline-danger")">
            <i class="bi bi-arrow-repeat me-1"></i> На доработке <span class="badge bg-light text-dark ms-1">@Model.NeedsRevisionCount</span>
        </a>
        <a asp-action="StudentReports" class="btn btn-sm @(Model.SelectedStatus == null && string.IsNullOrEmpty(Model.SearchQuery) && !Model.SelectedDisciplineId.HasValue && !Model.SelectedGroupId.HasValue ? "btn-secondary" : "btn-outline-secondary")">
            Все (@Model.TotalCount)
        </a>
    </div>
</div>

<!-- Фильтры и поиск -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="StudentReports" class="row g-2 align-items-center">
            <div class="col-md-3">
                <select name="disciplineId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">Все дисциплины</option>
                    @foreach (var d in Model.Disciplines)
                    {
                        <option value="@d.Id" selected="@(Model.SelectedDisciplineId == d.Id)">@d.Title</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="groupId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">Все учебные группы</option>
                    @foreach (var g in Model.Groups)
                    {
                        <option value="@g.Id" selected="@(Model.SelectedGroupId == g.Id)">@g.Name (@g.CourseNumber курс)</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Поиск по студенту, теме или файлу..." value="@Model.SearchQuery" />
                </div>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="bi bi-funnel me-1"></i> Применить
                </button>
                @if (Model.SelectedDisciplineId.HasValue || Model.SelectedGroupId.HasValue || Model.SelectedStatus.HasValue || !string.IsNullOrEmpty(Model.SearchQuery))
                {
                    <a asp-action="StudentReports" class="btn btn-outline-secondary btn-sm" title="Сбросить фильтры">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

@if (!Model.Reports.Any())
{
    <div class="card shadow-sm border-0 p-5 text-center text-muted">
        <i class="bi bi-inbox fs-1 text-primary opacity-50 mb-3"></i>
        <h5>Отчёты не найдены</h5>
        <p class="small mb-0">По заданным критериям поиска и фильтрации нет сданных студенческих отчётов.</p>
    </div>
}
else
{
    <div class="d-grid gap-4">
        @foreach (var r in Model.Reports)
        {
            string borderClass = r.Status switch
            {
                ReportSubmissionStatus.Approved => "border-success",
                ReportSubmissionStatus.NeedsRevision => "border-danger",
                ReportSubmissionStatus.Rejected => "border-secondary",
                _ => "border-warning"
            };

            string ext = System.IO.Path.GetExtension(r.OriginalFileName).ToLowerInvariant();
            string fileIcon = ext switch
            {
                ".pdf" => "bi-file-earmark-pdf-fill text-danger",
                ".doc" or ".docx" => "bi-file-earmark-word-fill text-primary",
                ".xls" or ".xlsx" => "bi-file-earmark-excel-fill text-success",
                ".zip" or ".rar" or ".7z" => "bi-file-earmark-zip-fill text-warning",
                ".ppt" or ".pptx" => "bi-file-earmark-slides-fill text-warning",
                ".png" or ".jpg" or ".jpeg" => "bi-file-earmark-image-fill text-info",
                _ => "bi-file-earmark-text-fill text-secondary"
            };

            <div class="card shadow-sm border-0 border-start @borderClass border-4">
                <div class="card-header py-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <span class="badge bg-primary me-2">@r.StudentGroupName</span>
                        <strong class="fs-6">@r.StudentFullName</strong>
                        <span class="text-muted small ms-2">Курс: <em>«@r.DisciplineTitle»</em> &rarr; <em>«@r.LectureTitle»</em></span>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <div class="text-muted small">
                            <i class="bi bi-clock me-1"></i>Отправлено: @r.SubmittedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                        </div>
                        @switch (r.Status)
                        {
                            case ReportSubmissionStatus.Pending:
                                <span class="badge bg-warning text-dark px-2 py-1"><i class="bi bi-hourglass-split me-1"></i>На проверке</span>
                                break;
                            case ReportSubmissionStatus.Approved:
                                <span class="badge bg-success px-2 py-1"><i class="bi bi-check-circle-fill me-1"></i>Зачтено (@(r.Grade ?? 0)/@(r.MaxScore ?? 100))</span>
                                break;
                            case ReportSubmissionStatus.NeedsRevision:
                                <span class="badge bg-danger px-2 py-1"><i class="bi bi-arrow-repeat me-1"></i>На доработке</span>
                                break;
                            case ReportSubmissionStatus.Rejected:
                                <span class="badge bg-secondary px-2 py-1"><i class="bi bi-x-circle me-1"></i>Не зачтено</span>
                                break;
                        }
                    </div>
                </div>

                <div class="card-body p-4">
                    <!-- Информация о файле студента -->
                    <div class="p-3 bg-light rounded border d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <i class="bi @fileIcon fs-2"></i>
                            <div>
                                <div class="fw-bold fs-6">@r.OriginalFileName</div>
                                <div class="text-muted small">
                                    Размер: @(r.FileSizeBytes >= 1024 * 1024 ? $"{(r.FileSizeBytes / (1024.0 * 1024.0)):F1} МБ" : $"{(r.FileSizeBytes / 1024.0):F0} КБ")
                                </div>
                            </div>
                        </div>
                        <a asp-action="DownloadStudentReport" asp-route-id="@r.Id" class="btn btn-outline-primary btn-sm px-3">
                            <i class="bi bi-download me-1"></i> Скачать файл для проверки
                        </a>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(r.StudentComment))
                    {
                        <div class="mb-3">
                            <div class="text-muted small fw-semibold text-uppercase">Комментарий студента к работе:</div>
                            <div class="p-2 px-3 bg-white border rounded small text-dark mt-1" style="white-space: pre-wrap;">@r.StudentComment</div>
                        </div>
                    }

                    @if (r.ReviewedAt.HasValue)
                    {
                        <div class="mb-3 p-3 bg-light rounded border">
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span><i class="bi bi-person-check me-1"></i>Проверил: <strong>@(r.ReviewedByTeacherName ?? "Преподаватель")</strong></span>
                                <span><i class="bi bi-calendar3 me-1"></i>@r.ReviewedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                            </div>
                            @if (!string.IsNullOrEmpty(r.TeacherFeedback))
                            {
                                <div class="small text-dark mt-1">
                                    <strong>Замечания / отзыв:</strong> @r.TeacherFeedback
                                </div>
                            }
                        </div>
                    }

                    <!-- Форма оценивания преподавателем -->
                    <div class="bg-light p-3 rounded border">
                        <div class="fw-semibold small text-uppercase mb-2 text-primary">
                            <i class="bi bi-pencil-square me-1"></i> Оценка и рецензия преподавателя
                        </div>
                        <form asp-action="GradeReport" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ReportId" value="@r.Id" />

                            <div class="row g-2 align-items-center mb-3">
                                <div class="col-sm-4">
                                    <label class="form-label small fw-semibold mb-1">Оценка (из @(r.MaxScore ?? 100) баллов):</label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" name="Grade" value="@(r.Grade ?? r.MaxScore ?? 100)" min="0" max="@(r.MaxScore ?? 100)" class="form-control" />
                                        <span class="input-group-text">/ @(r.MaxScore ?? 100)</span>
                                    </div>
                                </div>
                                <div class="col-sm-8">
                                    <label class="form-label small fw-semibold mb-1">Замечания / рекомендации студенту:</label>
                                    <input type="text" name="TeacherFeedback" value="@r.TeacherFeedback" class="form-control form-control-sm" placeholder="Например: Отличная работа, все требования выполнены" />
                                </div>
                            </div>

                            <div class="d-flex flex-wrap gap-2">
                                <button type="submit" name="Status" value="@((int)ReportSubmissionStatus.Approved)" class="btn btn-success btn-sm px-3 fw-semibold">
                                    <i class="bi bi-check-circle-fill me-1"></i> Зачесть работу
                                </button>
                                <button type="submit" name="Status" value="@((int)ReportSubmissionStatus.NeedsRevision)" class="btn btn-warning btn-sm px-3 text-dark fw-semibold">
                                    <i class="bi bi-arrow-repeat me-1"></i> Отправить на доработку
                                </button>
                                <button type="submit" name="Status" value="@((int)ReportSubmissionStatus.Rejected)" class="btn btn-outline-danger btn-sm px-3">
                                    <i class="bi bi-x-circle me-1"></i> Не зачтено
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}

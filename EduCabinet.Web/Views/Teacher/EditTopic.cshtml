@model TopicEditViewModel
@{
    ViewData["Title"] = "Редактирование темы";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header py-3 border-bottom">
                <h4 class="fw-bold mb-0 text-primary"><i class="bi bi-pencil-square me-2"></i>Редактирование темы</h4>
                <div class="text-muted small">Дисциплина: @Model.DisciplineTitle</div>
            </div>
            <div class="card-body p-4">
                <form asp-action="EditTopic" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="DisciplineId" />
                    <input type="hidden" asp-for="DisciplineTitle" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Название темы</label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Описание темы</label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="OrderIndex" class="form-label fw-semibold">Порядковый номер темы</label>
                        <input asp-for="OrderIndex" type="number" class="form-control" style="max-width: 120px;" />
                        <span asp-validation-for="OrderIndex" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center border-top pt-3">
                        <a asp-action="DisciplineDetails" asp-route-id="@Model.DisciplineId" class="btn btn-outline-secondary">Отмена</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check2 me-1"></i> Сохранить
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

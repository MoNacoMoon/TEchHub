@model Lecture
@{
    ViewData["Title"] = Model.Title;
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Disciplines">Дисциплины</a></li>
        <li class="breadcrumb-item"><a asp-action="DisciplineDetails" asp-route-id="@Model.Topic.DisciplineId">@Model.Topic.Discipline.Title</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
    </ol>
</nav>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <span class="badge bg-secondary mb-1">Тема: @Model.Topic.Title</span>
                <h3 class="fw-bold mb-1">@Model.Title</h3>
                <div class="text-muted small">
                    Порядковый номер: #@Model.OrderIndex | Дата создания: @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")
                </div>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="EditLecture" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-pencil me-1"></i> Редактировать теорию и файл
                </a>
                <a asp-action="DisciplineDetails" asp-route-id="@Model.Topic.DisciplineId" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> К структуре тем
                </a>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.AttachmentFilePath))
        {
            <div class="mt-3 p-3 bg-light rounded border d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-file-earmark-pdf-fill text-danger fs-4"></i>
                    <div>
                        <strong>Прикрепленный материал:</strong> @Model.AttachmentOriginalName
                    </div>
                </div>
                <a href="@Model.AttachmentFilePath" target="_blank" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-box-arrow-up-right me-1"></i> Просмотреть файл
                </a>
            </div>
        }
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- 1. Контрольные вопросы к лекции -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-primary">
                    <i class="bi bi-patch-question me-2"></i>Контрольные вопросы (@Model.ControlQuestions.Count)
                </h5>
                <a asp-action="CreateControlQuestion" asp-route-lectureId="@Model.Id" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-circle me-1"></i> Добавить вопрос
                </a>
            </div>
            <div class="list-group list-group-flush">
                @if (!Model.ControlQuestions.Any())
                {
                    <div class="p-4 text-center text-muted">
                        Контрольные вопросы еще не добавлены. Студент сможет завершить лекцию без вопросов.
                    </div>
                }
                @foreach (var q in Model.ControlQuestions.OrderBy(q => q.OrderIndex))
                {
                    <div class="list-group-item p-3">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge bg-secondary">#@q.OrderIndex</span>
                                    <span class="badge bg-light text-body border">@q.Type</span>
                                </div>
                                <div class="fw-semibold">@q.Text</div>

                                @if (q.Type == QuestionType.SingleChoice || q.Type == QuestionType.MultipleChoice)
                                {
                                    <div class="small text-muted mt-1">
                                        Вариантов: @q.Options.Count (правильных: @q.Options.Count(o => o.IsCorrect))
                                    </div>
                                }
                                else if (q.Type == QuestionType.ShortText || q.Type == QuestionType.FillBlank)
                                {
                                    <div class="small text-success mt-1">
                                        Эталон: <code>@q.CorrectTextAnswer</code>
                                    </div>
                                }
                                else if (q.Type == QuestionType.Matching)
                                {
                                    <div class="small text-muted mt-1">
                                        Элементов для сопоставления: @q.Options.Count
                                    </div>
                                }
                                else if (q.Type == QuestionType.OpenEnded)
                                {
                                    <div class="small text-warning mt-1">
                                        <i class="bi bi-person-check me-1"></i>Ручная проверка преподавателем
                                    </div>
                                }
                            </div>

                            <form asp-action="DeleteControlQuestion" asp-route-id="@q.Id" method="post" onsubmit="return confirm('Удалить контрольный вопрос?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Удалить">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- 2. Итоговое тестирование -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-primary">
                    <i class="bi bi-ui-checks me-2"></i>Итоговый тест
                </h5>
                <a asp-action="EditTest" asp-route-lectureId="@Model.Id" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-sliders me-1"></i> Настройки теста
                </a>
            </div>

            @if (Model.Test != null)
            {
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-2">@Model.Test.Title</h6>
                    <p class="text-muted small mb-3">@(Model.Test.Description ?? "Описание не задано")</p>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <div class="p-2 bg-light rounded text-center">
                                <span class="small text-muted d-block">Проходной балл</span>
                                <span class="fw-bold fs-5 text-primary">@Model.Test.PassingScorePercent%</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 bg-light rounded text-center">
                                <span class="small text-muted d-block">Лимит попыток</span>
                                <span class="fw-bold fs-5 text-body">@Model.Test.MaxAttempts</span>
                            </div>
                        </div>
                    </div>

                    <div class="small text-muted mb-3">
                        <div><i class="bi bi-clock me-1"></i>Лимит времени: <strong>@(Model.Test.TimeLimitMinutes.HasValue ? $"{Model.Test.TimeLimitMinutes.Value} мин" : "Без лимита")</strong></div>
                        <div><i class="bi bi-shuffle me-1"></i>Перемешивание вопросов: <strong>@(Model.Test.ShuffleQuestions ? "Включено" : "Выключено")</strong></div>
                        <div><i class="bi bi-patch-question me-1"></i>Вопросов в базе теста: <strong>@Model.Test.Questions.Count</strong></div>
                    </div>

                    <div class="d-grid gap-2">
                        <a asp-action="EditTest" asp-route-lectureId="@Model.Id" class="btn btn-primary btn-sm">
                            <i class="bi bi-list-task me-1"></i> Управление вопросами теста (@Model.Test.Questions.Count)
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="card-body p-4 text-center text-muted">
                    Тест еще не настроен.
                </div>
            }
        </div>
    </div>
</div>

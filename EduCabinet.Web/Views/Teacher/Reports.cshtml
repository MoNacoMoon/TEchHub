@model GroupProgressReportViewModel
@{
    ViewData["Title"] = "Отчеты и успеваемость студентов";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1">Отчеты и успеваемость</h2>
        <p class="text-muted mb-0">Матрица освоения лекций, результаты тестирования, выявление неуспевающих и ручное открытие материалов</p>
    </div>
</div>

<!-- Фильтры: Дисциплина и Группа -->
<div class="card shadow-sm border-0 mb-4 bg-light">
    <div class="card-body p-3">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label small fw-semibold text-muted">Учебная дисциплина:</label>
                <select name="disciplineId" class="form-select" onchange="this.form.submit()">
                    @if (!Model.Disciplines.Any())
                    {
                        <option value="">-- Дисциплины отсутствуют --</option>
                    }
                    @foreach (var d in Model.Disciplines)
                    {
                        <option value="@d.Id" selected="@(d.Id == Model.SelectedDisciplineId)">@d.Title</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted">Фильтр по группе:</label>
                <select name="groupId" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Все группы --</option>
                    @foreach (var g in Model.Groups)
                    {
                        <option value="@g.Id" selected="@(g.Id == Model.SelectedGroupId)">@g.Name (@g.Description)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-filter me-1"></i> Применить
                </button>
            </div>
        </form>
    </div>
</div>

@if (!Model.Disciplines.Any())
{
    <div class="card p-5 text-center text-muted border-dashed mb-4">
        <i class="bi bi-journal-bookmark fs-1 text-primary mb-2"></i>
        <h5>Учебные дисциплины еще не добавлены</h5>
        <p class="small">Для формирования сводного журнала успеваемости и аналитики создайте учебную дисциплину.</p>
        <div class="mt-2">
            <a asp-action="CreateDiscipline" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-circle me-1"></i> Создать дисциплину
            </a>
        </div>
    </div>
}
else
{
    int totalSt = Model.Students.Count;
    int excCount = Model.Students.Count(s => s.ProgressPercent >= 85);
    int goodCount = Model.Students.Count(s => s.ProgressPercent >= 70 && s.ProgressPercent < 85);
    int satCount = Model.Students.Count(s => s.ProgressPercent >= 50 && s.ProgressPercent < 70);
    int badCount = Model.Students.Count(s => s.ProgressPercent < 50);

    double avgProgress = totalSt > 0 ? Math.Round(Model.Students.Average(s => s.ProgressPercent), 1) : 0;
    int completedAll = Model.Students.Count(s => s.ProgressPercent == 100);

<!-- Аналитические показатели и распределение успеваемости группы -->
<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-primary">
                    <i class="bi bi-bar-chart-line-fill me-2"></i>Распределение успеваемости и качество освоения курса
                </h6>
                <span class="quiet-tag font-mono">Выборка: @totalSt студ.</span>
            </div>
            <div class="card-body p-4">
                <div class="row g-4 align-items-center">
                    <div class="col-md-7">
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="fw-bold text-success"><i class="bi bi-circle-fill me-1" style="font-size: 0.6rem;"></i>Отлично (85–100%)</span>
                                <span>@excCount студ. (@(totalSt > 0 ? (int)Math.Round((double)excCount / totalSt * 100) : 0)%)</span>
                            </div>
                            <div class="progress" style="height: 10px; border-radius: 5px;">
                                <div class="progress-bar bg-success" style="width: @(totalSt > 0 ? (int)Math.Round((double)excCount / totalSt * 100) : 0)%;"></div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="fw-bold text-primary"><i class="bi bi-circle-fill me-1" style="font-size: 0.6rem;"></i>Хорошо (70–84%)</span>
                                <span>@goodCount студ. (@(totalSt > 0 ? (int)Math.Round((double)goodCount / totalSt * 100) : 0)%)</span>
                            </div>
                            <div class="progress" style="height: 10px; border-radius: 5px;">
                                <div class="progress-bar bg-primary" style="width: @(totalSt > 0 ? (int)Math.Round((double)goodCount / totalSt * 100) : 0)%;"></div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="fw-bold text-warning"><i class="bi bi-circle-fill me-1" style="font-size: 0.6rem;"></i>Удовлетворительно (50–69%)</span>
                                <span>@satCount студ. (@(totalSt > 0 ? (int)Math.Round((double)satCount / totalSt * 100) : 0)%)</span>
                            </div>
                            <div class="progress" style="height: 10px; border-radius: 5px;">
                                <div class="progress-bar bg-warning" style="width: @(totalSt > 0 ? (int)Math.Round((double)satCount / totalSt * 100) : 0)%;"></div>
                            </div>
                        </div>

                        <div>
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="fw-bold text-danger"><i class="bi bi-circle-fill me-1" style="font-size: 0.6rem;"></i>Отстающие (&lt;50%)</span>
                                <span>@badCount студ. (@(totalSt > 0 ? (int)Math.Round((double)badCount / totalSt * 100) : 0)%)</span>
                            </div>
                            <div class="progress" style="height: 10px; border-radius: 5px;">
                                <div class="progress-bar bg-danger" style="width: @(totalSt > 0 ? (int)Math.Round((double)badCount / totalSt * 100) : 0)%;"></div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-5 border-start-md">
                        <div class="text-center p-2">
                            <div class="display-5 fw-bold text-primary mb-1">@avgProgress%</div>
                            <div class="text-muted small fw-semibold">Средний прогресс группы</div>
                            <div class="badge bg-success-subtle text-success border border-success-subtle mt-2 p-2 w-100">
                                <i class="bi bi-mortarboard-fill me-1"></i> Завершили курс: @completedAll из @totalSt
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header py-3 border-bottom">
                <h6 class="fw-bold mb-0 text-primary"><i class="bi bi-speedometer2 text-info me-2"></i>Педагогические метрики</h6>
            </div>
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                    <span class="text-muted small">Успеваемость (>=50%):</span>
                    <span class="fw-bold">@(totalSt > 0 ? Math.Round((double)(totalSt - badCount) / totalSt * 100, 1) : 0)%</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                    <span class="text-muted small">Качество знаний (>=70%):</span>
                    <span class="fw-bold text-success">@(totalSt > 0 ? Math.Round((double)(excCount + goodCount) / totalSt * 100, 1) : 0)%</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                    <span class="text-muted small">Всего лекций в плане:</span>
                    <span class="fw-bold">@Model.Lectures.Count</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-2">
                    <span class="text-muted small">Экспорт ведомости:</span>
                    <a asp-action="ExportGroupReport" asp-route-disciplineId="@Model.SelectedDisciplineId" asp-route-groupId="@Model.SelectedGroupId" class="badge bg-success text-decoration-none">
                        <i class="bi bi-download me-1"></i>Скачать CSV
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 1. Матрица успеваемости студентов -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-primary">
            <i class="bi bi-grid-3x3-gap-fill me-2"></i>Матрица прогресса по дисциплине «@Model.DisciplineTitle»
        </h5>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="ExportGroupReport" asp-route-disciplineId="@Model.SelectedDisciplineId" asp-route-groupId="@Model.SelectedGroupId" class="btn btn-success btn-sm" title="Выгрузить ведомость успеваемости в формате CSV для Microsoft Excel">
                <i class="bi bi-file-earmark-excel-fill me-1"></i> Экспорт в Excel / CSV
            </a>
            <span class="quiet-tag font-mono">Студентов: @Model.Students.Count</span>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle mb-0 text-center">
            <thead class="table-light">
                <tr>
                    <th class="text-start" style="min-width: 220px;">Студент / Группа</th>
                    <th style="width: 120px;">Общий прогресс</th>
                    @foreach (var lec in Model.Lectures)
                    {
                        <th style="min-width: 140px;" title="@lec.Title">
                            <div class="small fw-bold">Лекция @lec.OrderIndex</div>
                            <div class="small text-muted text-truncate" style="max-width: 130px;">@lec.Title</div>
                        </th>
                    }
                    <th style="width: 150px;">Действия</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Students.Any())
                {
                    <tr>
                        <td colspan="@(Model.Lectures.Count + 3)" class="text-center py-4 text-muted">
                            В выбранной группе нет зарегистрированных студентов.
                        </td>
                    </tr>
                }
                @foreach (var s in Model.Students)
                {
                    <tr>
                        <td class="text-start">
                            <div class="fw-bold">@s.FullName</div>
                            <span class="badge bg-secondary">@s.GroupName</span>
                        </td>
                        <td>
                            <div class="fw-bold fs-6 @(s.ProgressPercent == 100 ? "text-success" : "text-primary")">@s.ProgressPercent%</div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-success" style="width: @s.ProgressPercent%;"></div>
                            </div>
                        </td>

                        @foreach (var lec in Model.Lectures)
                        {
                            s.LectureStatuses.TryGetValue(lec.Id, out var stat);
                            <td>
                                @if (stat != null && stat.IsCompleted)
                                {
                                    <span class="badge bg-success p-2" title="Лекция успешно пройдена">
                                        <i class="bi bi-check-circle me-1"></i>Сдано
                                        @if (stat.TestScorePercent.HasValue)
                                        {
                                            <span>(@stat.TestScorePercent%)</span>
                                        }
                                    </span>
                                }
                                else if (stat != null && stat.IsManuallyUnlocked)
                                {
                                    <span class="badge bg-warning text-dark p-2" title="Открыта преподавателем вручную">
                                        <i class="bi bi-unlock-fill me-1"></i>Вручную
                                    </span>
                                }
                                else if (stat != null && (stat.IsControlQuestionsPassed || stat.AttemptsCount > 0))
                                {
                                    <span class="badge bg-info text-dark p-2" title="В процессе прохождения">
                                        <i class="bi bi-hourglass-split me-1"></i>В процессе
                                        @if (stat.TestScorePercent.HasValue)
                                        {
                                            <span>(@stat.TestScorePercent%)</span>
                                        }
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border p-2" title="Не доступна или не начата">
                                        <i class="bi bi-lock me-1"></i>Закрыто
                                    </span>
                                }
                            </td>
                        }

                        <td>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    Управление
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <button class="dropdown-item" onclick="openManualUnlockModal(@s.StudentId, '@s.FullName')">
                                            <i class="bi bi-key me-2 text-warning"></i>Открыть лекцию вручную
                                        </button>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.DifficultQuestions != null && Model.DifficultQuestions.Any())
{
    <!-- Аналитика трудных вопросов тестов -->
    <div class="card shadow-sm border-0 mb-4 border-start border-warning border-4">
        <div class="card-header py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-body">
                <i class="bi bi-fire text-danger me-2"></i>Анализ сложных вопросов тестов («Тепловая карта» ошибок)
            </h5>
            <span class="badge bg-warning-subtle text-warning border">Топ-5 проблемных вопросов</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 45%;">Формулировка вопроса</th>
                            <th style="width: 25%;">Тест / Лекция</th>
                            <th style="width: 15%; text-align: center;">Всего ответов</th>
                            <th style="width: 15%; text-align: center;">Ошибок (%)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dq in Model.DifficultQuestions)
                        {
                            <tr>
                                <td class="fw-semibold">@dq.QuestionText</td>
                                <td class="small text-muted">@dq.TestTitle <br /><span class="badge bg-light text-body border">@dq.LectureTitle</span></td>
                                <td class="text-center">@dq.TotalAnswers (неверно: @dq.IncorrectAnswers)</td>
                                <td class="text-center">
                                    <div class="d-flex align-items-center justify-content-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 8px; max-width: 80px;">
                                            <div class="progress-bar bg-danger" style="width: @dq.ErrorRatePercent%;"></div>
                                        </div>
                                        <span class="fw-bold text-danger">@dq.ErrorRatePercent%</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- 2. Студенты, не завершившие изучение темы / застрявшие на лекции -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-danger">
            <i class="bi bi-exclamation-octagon-fill me-2"></i>Контроль задолженностей: студенты, не завершившие курс
        </h5>
        <span class="badge bg-danger">@Model.IncompleteStudents.Count</span>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>ФИО студента</th>
                    <th>Группа</th>
                    <th>Последняя сданная лекция</th>
                    <th>Текущая заблокированная лекция</th>
                    <th>Причина задержки</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.IncompleteStudents.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-success fw-bold">
                            <i class="bi bi-trophy me-1"></i> Все студенты группы успешно завершили изучение всех лекций!
                        </td>
                    </tr>
                }
                @foreach (var inc in Model.IncompleteStudents)
                {
                    <tr>
                        <td class="fw-bold">@inc.StudentFullName</td>
                        <td><span class="badge bg-secondary">@inc.GroupName</span></td>
                        <td>@inc.LastCompletedLecture</td>
                        <td class="text-danger fw-semibold">@inc.BlockedAtLecture</td>
                        <td><span class="badge bg-danger-subtle text-danger border border-danger-subtle">@inc.Reason</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
}

<!-- Модальное окно ручного открытия лекции преподавателем -->
<div class="modal fade" id="manualUnlockModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="ManualUnlock" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="StudentId" id="unlockStudentId" />

                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-primary">
                        <i class="bi bi-key-fill me-2"></i>Ручное открытие лекции
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <p class="small text-muted">
                        Преподаватель может открыть доступ к любой лекции отдельному студенту в индивидуальном порядке. Действие обязательно регистрируется в журнале аудита.
                    </p>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Студент:</label>
                        <input type="text" id="unlockStudentName" class="form-control" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Выберите лекцию для открытия:</label>
                        <select name="LectureId" class="form-select" required>
                            @foreach (var lec in Model.Lectures)
                            {
                                <option value="@lec.Id">Лекция @lec.OrderIndex: @lec.Title</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Обоснование / причина открытия:</label>
                        <textarea name="Reason" class="form-control" rows="3" placeholder="Укажите причину (например: индивидуальный план, прохождение очной аттестации)..." required></textarea>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-warning fw-semibold">
                        <i class="bi bi-unlock-fill me-1"></i> Подтвердить открытие
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openManualUnlockModal(studentId, studentName) {
            document.getElementById("unlockStudentId").value = studentId;
            document.getElementById("unlockStudentName").value = studentName;
            const modal = new bootstrap.Modal(document.getElementById("manualUnlockModal"));
            modal.show();
        }
    </script>
}

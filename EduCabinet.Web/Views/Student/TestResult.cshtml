@model TestResultViewModel
@{
    ViewData["Title"] = "Результаты тестирования";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 mb-4 text-center">
            <div class="card-body p-5">
                @if (Model.IsPassed)
                {
                    <div class="display-3 text-success mb-3">
                        <i class="bi bi-patch-check-fill"></i>
                    </div>
                    <h2 class="fw-bold text-success">Тест успешно сдан!</h2>
                    <p class="text-muted">Вы успешно подтвердили усвоение теоретического материала лекции.</p>
                }
                else
                {
                    <div class="display-3 text-danger mb-3">
                        <i class="bi bi-x-circle-fill"></i>
                    </div>
                    <h2 class="fw-bold text-danger">Тест не сдан</h2>
                    <p class="text-muted">Набранный процент правильных ответов ниже установленного порога.</p>
                }

                <div class="row g-3 justify-content-center mt-3">
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-light rounded">
                            <div class="small text-muted">Ваш результат</div>
                            <div class="fs-2 fw-bold @(Model.IsPassed ? "text-success" : "text-danger")">@Model.ScorePercent%</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-light rounded">
                            <div class="small text-muted">Проходной балл</div>
                            <div class="fs-2 fw-bold text-body">@Model.PassingScorePercent%</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-light rounded">
                            <div class="small text-muted">Правильных ответов</div>
                            <div class="fs-2 fw-bold text-body">@Model.CorrectQuestions из @Model.TotalQuestions</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-light rounded">
                            <div class="small text-muted">Осталось попыток</div>
                            <div class="fs-2 fw-bold @(Model.AttemptsRemaining > 0 ? "text-primary" : "text-muted")">@Model.AttemptsRemaining</div>
                        </div>
                    </div>
                </div>

                @if (Model.IsPassed && Model.NextLectureUnlocked && Model.NextLectureId.HasValue)
                {
                    <div class="alert alert-success border mt-4 text-start">
                        <div class="d-flex align-items-center gap-3">
                            <i class="bi bi-unlock-fill fs-2 text-success"></i>
                            <div>
                                <h6 class="fw-bold mb-1">Следующая лекция разблокирована!</h6>
                                <p class="mb-0 small">Все обязательные условия выполнены. Вы можете перейти к следующей теме курса.</p>
                            </div>
                        </div>
                    </div>
                }
                else if (!Model.IsPassed && Model.AttemptsRemaining > 0)
                {
                    <div class="alert alert-warning border mt-4 text-start">
                        <div class="d-flex align-items-center gap-3">
                            <i class="bi bi-arrow-repeat fs-2 text-warning"></i>
                            <div>
                                <h6 class="fw-bold mb-1">Повторите теоретический материал</h6>
                                <p class="mb-0 small">У вас осталось еще @Model.AttemptsRemaining попыток. Перечитайте лекцию и пройдите тестирование повторно.</p>
                            </div>
                        </div>
                    </div>
                }

                <div class="d-flex flex-wrap justify-content-center gap-3 mt-4">
                    <a asp-action="Lecture" asp-route-id="@Model.LectureId" class="btn btn-outline-secondary">
                        <i class="bi bi-book me-1"></i> Вернуться к материалам лекции
                    </a>

                    @if (!Model.IsPassed && Model.AttemptsRemaining > 0)
                    {
                        <a asp-action="TakeTest" asp-route-id="@Model.TestId" class="btn btn-warning">
                            <i class="bi bi-arrow-repeat me-1"></i> Попробовать снова
                        </a>
                    }

                    @if (Model.NextLectureUnlocked && Model.NextLectureId.HasValue)
                    {
                        <a asp-action="Lecture" asp-route-id="@Model.NextLectureId.Value" class="btn btn-success fw-semibold">
                            Перейти к следующей лекции <i class="bi bi-arrow-right-circle-fill ms-1"></i>
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Детальный разбор ответов -->
        <div class="card shadow-sm border-0 mb-5">
            <div class="card-header py-3 border-bottom">
                <h5 class="fw-bold mb-0"><i class="bi bi-list-check me-2"></i>Детализация ответов попытки #@Model.AttemptNumber:</h5>
            </div>
            <div class="list-group list-group-flush">
                @for (int i = 0; i < Model.Answers.Count; i++)
                {
                    var a = Model.Answers[i];
                    <div class="list-group-item p-3">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div class="d-flex align-items-start gap-3">
                                @if (!string.IsNullOrEmpty(a.ImageUrl))
                                {
                                    <div class="flex-shrink-0">
                                        <img src="@a.ImageUrl" alt="Иллюстрация к вопросу" class="rounded border shadow-sm" style="width: 60px; height: 60px; object-fit: cover;" />
                                    </div>
                                }
                                <div>
                                    <span class="fw-semibold">Вопрос @(i + 1):</span> @a.QuestionText
                                </div>
                            </div>
                            <div>
                                @if (a.IsCorrect)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-lg me-1"></i>Верно</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger"><i class="bi bi-x-lg me-1"></i>Неверно</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

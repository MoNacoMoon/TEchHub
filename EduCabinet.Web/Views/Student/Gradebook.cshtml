@model StudentGradebookViewModel
@{
    ViewData["Title"] = "Электронная зачётная книжка";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-journal-check text-primary me-2"></i>Электронная зачётная книжка
        </h2>
        <p class="text-muted mb-0">Сводные академические результаты, успеваемость и допуск по учебным дисциплинам</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-primary-subtle text-primary border fs-6 px-3 py-2">
            <i class="bi bi-people-fill me-1"></i> Группа: <strong>@Model.GroupName</strong>
        </span>
    </div>
</div>

<!-- Статистические карточки студента -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body p-3 text-center">
                <div class="text-muted small mb-1">Средний балл (GPA)</div>
                <div class="fs-2 fw-bold text-primary">@(Model.OverallAverageScore > 0 ? $"{Model.OverallAverageScore}%" : "—")</div>
                <div class="text-muted small">По всем тестам</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body p-3 text-center">
                <div class="text-muted small mb-1">Завершено курсов</div>
                <div class="fs-2 fw-bold text-success">@Model.CompletedDisciplinesCount / @Model.TotalDisciplinesCount</div>
                <div class="text-muted small">Полностью освоены</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body p-3 text-center">
                <div class="text-muted small mb-1">Сдано тестов</div>
                <div class="fs-2 fw-bold text-info">@Model.TotalTestsPassed</div>
                <div class="text-muted small">Итоговых тестирований</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body p-3 text-center">
                <div class="text-muted small mb-1">Зачтено отчётов</div>
                <div class="fs-2 fw-bold text-warning">@Model.TotalReportsApproved</div>
                <div class="text-muted small">Лабораторных и практических</div>
            </div>
        </div>
    </div>
</div>

<!-- Список дисциплин в зачётке -->
@if (!Model.Disciplines.Any())
{
    <div class="card shadow-sm border-0 p-5 text-center text-muted">
        <i class="bi bi-journal-x fs-1 text-primary opacity-50 mb-3"></i>
        <h5>Нет закрепленных дисциплин</h5>
        <p class="small mb-0">Для вашей учебной группы пока не назначены активные учебные курсы.</p>
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="card-header py-3 bg-white border-bottom">
            <h5 class="fw-bold mb-0">Ведомость успеваемости студента: @Model.StudentFullName</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th style="min-width: 220px;">Дисциплина / Преподаватель</th>
                        <th class="text-center" style="width: 150px;">Прогресс курса</th>
                        <th class="text-center" style="width: 140px;">Тестирование</th>
                        <th class="text-center" style="width: 150px;">Отчёты и лабы</th>
                        <th class="text-center" style="width: 150px;">Итоговый статус</th>
                        <th class="text-end" style="width: 140px;">Действие</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.Disciplines)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold fs-6">@d.Title</div>
                                <div class="text-muted small"><i class="bi bi-person me-1"></i>@d.TeacherName</div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height: 8px;">
                                        <div class="progress-bar @(d.ProgressPercent >= 100 ? "bg-success" : "bg-primary")" role="progressbar" style="width: @d.ProgressPercent%;" aria-valuenow="@d.ProgressPercent" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <span class="small fw-bold text-nowrap">@d.ProgressPercent%</span>
                                </div>
                                <div class="text-muted small mt-1">@d.CompletedLectures из @d.TotalLectures лекций</div>
                            </td>
                            <td class="text-center">
                                @if (d.AverageTestScore.HasValue)
                                {
                                    <span class="badge @(d.AverageTestScore >= 85 ? "bg-success" : (d.AverageTestScore >= 70 ? "bg-primary" : "bg-warning text-dark")) px-2 py-1">
                                        @d.AverageTestScore%
                                    </span>
                                    <div class="text-muted small mt-1">Сдано: @d.TestsPassedCount из @d.TotalTestsCount</div>
                                }
                                else if (d.TotalTestsCount > 0)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border">0 / @d.TotalTestsCount</span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (d.TotalReportsCount > 0)
                                {
                                    if (d.ReportsApprovedCount == d.TotalReportsCount)
                                    {
                                        <span class="badge bg-success-subtle text-success border">
                                            <i class="bi bi-check-circle-fill me-1"></i>@d.ReportsApprovedCount / @d.TotalReportsCount
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border">
                                            @d.ReportsApprovedCount / @d.TotalReportsCount зачтено
                                        </span>
                                    }
                                    @if (d.TotalReportScorePossible > 0)
                                    {
                                        <div class="text-muted small mt-1">Баллы: @d.TotalReportScoreEarned / @d.TotalReportScorePossible</div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">Не предусмотрены</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (d.IsCompleted)
                                {
                                    <span class="badge bg-success p-2">
                                        <i class="bi bi-award-fill me-1"></i>Курс завершён
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-primary-subtle text-primary border p-2">
                                        <i class="bi bi-hourglass-split me-1"></i>В процессе
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-1">
                                    <a asp-action="Discipline" asp-route-id="@d.DisciplineId" class="btn btn-outline-primary btn-sm" title="Открыть материалы дисциплины">
                                        <i class="bi bi-arrow-right"></i>
                                    </a>
                                    @if (d.CanGetCertificate)
                                    {
                                        <a asp-action="Certificate" asp-route-id="@d.DisciplineId" target="_blank" class="btn btn-outline-success btn-sm" title="Открыть сертификат с QR-кодом">
                                            <i class="bi bi-file-earmark-pdf"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

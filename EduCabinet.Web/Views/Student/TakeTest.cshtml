@model TakeTestViewModel
@{
    ViewData["Title"] = "Тестирование: " + Model.TestTitle;
}

<!-- Липкая панель управления тестированием с таймером -->
<div class="card shadow-sm border-0 mb-4 sticky-top" style="z-index: 1020; backdrop-filter: blur(12px); border-radius: 16px;">
    <div class="card-body p-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge bg-primary">Попытка #@Model.AttemptNumber</span>
                    <span class="badge bg-light text-muted border">Вопросов: @Model.Questions.Count</span>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">Проходной балл: @Model.PassingScorePercent%</span>
                </div>
                <h5 class="fw-bold mb-0 text-body">@Model.TestTitle</h5>
                <div class="text-muted small">Лекция: <strong>@Model.LectureTitle</strong></div>
            </div>

            @if (Model.TimeLimitSeconds.HasValue)
            {
                <div class="d-flex align-items-center gap-2">
                    <span class="text-muted small d-none d-sm-inline">Осталось времени:</span>
                    <div id="timerBadge" class="badge bg-primary fs-5 px-3 py-2 font-monospace shadow-sm">
                        <i class="bi bi-clock me-1"></i><span id="timerDisplay">--:--</span>
                    </div>
                </div>
            }
        </div>

        <!-- Навигационная полоса вопросов -->
        <div class="d-flex flex-wrap gap-1 mt-3 pt-2 border-top">
            <span class="small text-muted me-2 align-self-center">Вопросы:</span>
            @for (int i = 0; i < Model.Questions.Count; i++)
            {
                <a href="#question_card_@i" class="btn btn-sm btn-outline-secondary py-0 px-2 rounded-pill" style="font-size: 0.75rem;">
                    @(i + 1)
                </a>
            }
        </div>
    </div>
</div>

<form id="testForm" asp-action="SubmitTest" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="TestId" value="@Model.TestId" />

    <div class="d-grid gap-4 mb-4">
        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            var q = Model.Questions[i];
            <div class="card shadow-sm border-0" id="question_card_@i">
                <div class="card-header bg-transparent py-3 border-bottom d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-dark rounded-pill">Вопрос @(i + 1) из @Model.Questions.Count</span>
                        <span class="badge bg-light text-body border">@q.Type</span>
                    </div>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Балл: @q.Points</span>
                </div>
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3 text-body">@q.Text</h5>

                    @if (!string.IsNullOrEmpty(q.ImageUrl))
                    {
                        <div class="mb-3 text-start">
                            <a href="@q.ImageUrl" target="_blank" class="test-img-zoom-btn text-decoration-none d-inline-block" onclick="openTestImageModal('@q.ImageUrl'); return false;">
                                <div class="position-relative d-inline-block rounded border p-1 bg-light shadow-sm">
                                    <img src="@q.ImageUrl" alt="Иллюстрация к заданию" class="img-fluid rounded" style="max-height: 380px; max-width: 100%; object-fit: contain;" />
                                    <span class="badge bg-dark bg-opacity-75 position-absolute bottom-0 end-0 m-2">
                                        <i class="bi bi-zoom-in me-1"></i>Увеличить
                                    </span>
                                </div>
                            </a>
                        </div>
                    }

                    @if (q.Type == QuestionType.SingleChoice)
                    {
                        <div class="mb-2 d-grid gap-2">
                            @foreach (var opt in q.Options)
                            {
                                <label class="card p-3 border rounded-3 mb-1 text-body cursor-pointer d-flex flex-row align-items-center gap-3 option-label-hover" for="opt_@(q.Id)_@(opt.Id)">
                                    <input class="form-check-input mt-0 fs-5 flex-shrink-0" type="radio" name="Answers[@q.Id]" id="opt_@(q.Id)_@(opt.Id)" value="@opt.Id" />
                                    @if (!string.IsNullOrEmpty(opt.ImageUrl))
                                    {
                                        <img src="@opt.ImageUrl" alt="Вариант" class="rounded border flex-shrink-0" style="max-width: 90px; max-height: 70px; object-fit: cover;" />
                                    }
                                    <span class="fs-6">@opt.Text</span>
                                </label>
                            }
                        </div>
                    }
                    else if (q.Type == QuestionType.MultipleChoice)
                    {
                        <div class="mb-2">
                            <p class="text-muted small mb-2"><i class="bi bi-check2-square me-1"></i>Выберите один или несколько правильных вариантов:</p>
                            <div class="d-grid gap-2">
                                @foreach (var opt in q.Options)
                                {
                                    <label class="card p-3 border rounded-3 mb-1 text-body cursor-pointer d-flex flex-row align-items-center gap-3 option-label-hover" for="opt_@(q.Id)_@(opt.Id)">
                                        <input class="form-check-input mt-0 fs-5 mcq-cb-@q.Id flex-shrink-0" type="checkbox" id="opt_@(q.Id)_@(opt.Id)" value="@opt.Id" onchange="updateMcqHidden(@q.Id)" />
                                        @if (!string.IsNullOrEmpty(opt.ImageUrl))
                                        {
                                            <img src="@opt.ImageUrl" alt="Вариант" class="rounded border flex-shrink-0" style="max-width: 90px; max-height: 70px; object-fit: cover;" />
                                        }
                                        <span class="fs-6">@opt.Text</span>
                                    </label>
                                }
                            </div>
                            <input type="hidden" id="mcq_hidden_@q.Id" name="Answers[@q.Id]" value="" />
                        </div>
                    }
                    else if (q.Type == QuestionType.ShortText || q.Type == QuestionType.FillBlank)
                    {
                        <div class="mb-2 col-md-8">
                            <label class="form-label small text-muted">Введите ваш ответ:</label>
                            <input type="text" name="Answers[@q.Id]" class="form-control form-control-lg fs-6" placeholder="Введите краткий ответ..." autocomplete="off" />
                        </div>
                    }
                    else if (q.Type == QuestionType.Matching)
                    {
                        <div class="mb-2">
                            <p class="text-muted small mb-2"><i class="bi bi-arrows-expand me-1"></i>Установите соответствие для каждого пункта:</p>
                            <div class="row g-3">
                                @foreach (var opt in q.Options)
                                {
                                    <div class="col-md-6">
                                        <div class="card p-3 bg-light border h-100 rounded-3">
                                            <span class="small fw-bold text-body mb-2 d-block">@opt.Text</span>
                                            <select class="form-select matching-sel-@q.Id" data-opt-id="@opt.Id" onchange="updateMatchingHidden(@q.Id)">
                                                <option value="">-- Выберите пару --</option>
                                                @foreach (var target in q.MatchingTargets)
                                                {
                                                    <option value="@target">@target</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                }
                            </div>
                            <input type="hidden" id="matching_hidden_@q.Id" name="Answers[@q.Id]" value="" />
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Нижняя панель подтверждения -->
    <div class="card shadow-sm border-0 p-3 mb-5">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <a asp-action="Lecture" asp-route-id="@Model.LectureId" class="btn btn-outline-secondary" onclick="return confirm('Вы уверены, что хотите прервать тестирование? Текущий прогресс не сохранится.')">
                <i class="bi bi-x-circle me-1"></i> Прервать тестирование
            </a>

            <button type="submit" class="btn btn-primary btn-lg px-4 fw-semibold shadow-sm" onclick="return confirmSubmission()">
                <i class="bi bi-check2-circle me-1"></i> Завершить и отправить тест
            </button>
        </div>
    </div>
</form>

<!-- Модальное окно для полноразмерного просмотра иллюстрации задания -->
<div class="modal fade" id="testImageZoomModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content border-0 bg-transparent">
            <div class="modal-header border-0 pb-0 justify-content-end">
                <button type="button" class="btn btn-dark btn-sm rounded-circle shadow" data-bs-dismiss="modal" aria-label="Закрыть">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body p-2 text-center">
                <img id="testZoomedModalImage" src="" alt="Увеличенное изображение задания" class="img-fluid rounded shadow-lg bg-white p-1" style="max-height: 85vh; object-fit: contain;" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openTestImageModal(url) {
            document.getElementById('testZoomedModalImage').src = url;
            const modal = new bootstrap.Modal(document.getElementById('testImageZoomModal'));
            modal.show();
        }

        function updateMcqHidden(questionId) {
            const checked = Array.from(document.querySelectorAll(`.mcq-cb-${questionId}:checked`)).map(cb => cb.value);
            document.getElementById(`mcq_hidden_${questionId}`).value = checked.join(',');
        }

        function updateMatchingHidden(questionId) {
            const selects = document.querySelectorAll(`.matching-sel-${questionId}`);
            const pairs = [];
            selects.forEach(s => {
                if (s.value) {
                    pairs.push(`${s.dataset.optId}:${s.value}`);
                }
            });
            document.getElementById(`matching_hidden_${questionId}`).value = pairs.join(';');
        }

        function confirmSubmission() {
            return confirm("Вы уверены, что готовы завершить тест? После отправки результаты будут зафиксированы.");
        }

        const initialSeconds = @(Model.TimeLimitSeconds ?? 0);
        if (initialSeconds > 0) {
            let secondsLeft = initialSeconds;
            const timerDisplay = document.getElementById("timerDisplay");
            const timerBadge = document.getElementById("timerBadge");

            function updateTimer() {
                const mins = Math.floor(secondsLeft / 60);
                const secs = secondsLeft % 60;
                if (timerDisplay) {
                    timerDisplay.innerText = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
                }

                if (secondsLeft <= 60 && timerBadge) {
                    timerBadge.className = "badge bg-danger fs-5 px-3 py-2 font-monospace timer-pulse-warning";
                    if (secondsLeft === 60 && window.EduCabinet && window.EduCabinet.showToast) {
                        window.EduCabinet.showToast("Внимание: осталась последняя минута! Завершите выбор вариантов и отправьте форму.", "danger", "bi-exclamation-triangle-fill");
                    }
                }

                if (secondsLeft <= 0) {
                    clearInterval(timerInterval);
                    alert("Время на прохождение теста истекло! Ваши ответы будут автоматически отправлены.");
                    document.getElementById("testForm").submit();
                } else {
                    secondsLeft--;
                }
            }

            updateTimer();
            const timerInterval = setInterval(updateTimer, 1000);
        }
    </script>
}

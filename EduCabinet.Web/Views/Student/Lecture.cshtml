@model LectureStudyViewModel
@{
    ViewData["Title"] = Model.Title;
    int words = (Model.ContentHtml ?? "").Split(new[] { ' ', '\t', '\n', '<', '>' }, StringSplitOptions.RemoveEmptyEntries).Length;
    int readingMinutes = Math.Max(2, (int)Math.Ceiling(words / 120.0));
}

<div id="readingProgressBar" class="reading-progress-bar"></div>

<nav aria-label="breadcrumb" class="mb-3 zen-hide">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Мои дисциплины</a></li>
        <li class="breadcrumb-item"><a asp-action="Discipline" asp-route-id="@Model.DisciplineId">@Model.DisciplineTitle</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
    </ol>
</nav>

<!-- Заголовок лекции и текущий статус -->
<div class="card shadow-sm border-0 mb-4 zen-hide">
    <div class="card-body p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <span class="badge bg-secondary mb-2">@Model.TopicTitle</span>
                <h3 class="fw-bold mb-1">@Model.Title</h3>
                <div class="text-muted small">
                    Лекция №@Model.OrderIndex в теме
                </div>
            </div>
            <div>
                @if (Model.IsCompleted)
                {
                    <span class="badge bg-success p-2 px-3 fs-6">
                        <i class="bi bi-check-circle-fill me-1"></i> Лекция изучена
                    </span>
                }
                else
                {
                    <span class="badge bg-primary p-2 px-3 fs-6">
                        <i class="bi bi-hourglass-split me-1"></i> В процессе изучения
                    </span>
                }
            </div>
        </div>

        <!-- Статус выполнения обязательных условий -->
        <div class="row g-2 mt-3 pt-3 border-top">
            <div class="col-md-@(Model.RequiresReportSubmission ? "4" : "6")">
                <div class="d-flex align-items-center gap-2 small">
                    @if (Model.IsControlQuestionsPassed)
                    {
                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                        <span><strong>Контрольные вопросы:</strong> выполнены</span>
                    }
                    else
                    {
                        <i class="bi bi-dash-circle text-warning fs-5"></i>
                        <span><strong>Контрольные вопросы:</strong> требуется ответить</span>
                    }
                </div>
            </div>
            <div class="col-md-@(Model.RequiresReportSubmission ? "4" : "6")">
                <div class="d-flex align-items-center gap-2 small">
                    @if (Model.IsTestPassed)
                    {
                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                        <span><strong>Итоговый тест:</strong> сдан</span>
                    }
                    else
                    {
                        <i class="bi bi-dash-circle text-warning fs-5"></i>
                        <span><strong>Итоговый тест:</strong> требуется сдать тест</span>
                    }
                </div>
            </div>
            @if (Model.RequiresReportSubmission)
            {
                <div class="col-md-4">
                    <div class="d-flex align-items-center gap-2 small">
                        @if (Model.IsReportApproved)
                        {
                            <i class="bi bi-check-circle-fill text-success fs-5"></i>
                            <span><strong>Отчёт:</strong> зачтено @(Model.ReportGrade.HasValue ? $"({Model.ReportGrade}/{Model.MaxReportScore ?? 100} б.)" : "")</span>
                        }
                        else if (Model.CurrentReportSubmission != null && Model.CurrentReportSubmission.Status == ReportSubmissionStatus.Pending)
                        {
                            <i class="bi bi-hourglass-split text-warning fs-5"></i>
                            <span><strong>Отчёт:</strong> на проверке</span>
                        }
                        else if (Model.CurrentReportSubmission != null && Model.CurrentReportSubmission.Status == ReportSubmissionStatus.NeedsRevision)
                        {
                            <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                            <span><strong>Отчёт:</strong> на доработке</span>
                        }
                        else
                        {
                            <i class="bi bi-dash-circle text-warning fs-5"></i>
                            <span><strong>Отчёт:</strong> требуется сдать файл</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Вкладки: Теория, Контрольные вопросы, Тест, Отчёт -->
<ul class="nav nav-pills mb-4 gap-2" id="lectureTab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active fw-semibold" id="theory-tab" data-bs-toggle="pill" data-bs-target="#theory-pane" type="button" role="tab" aria-controls="theory-pane" aria-selected="true">
            <i class="bi bi-book me-1"></i> Теоретический материал
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-semibold position-relative" id="questions-tab" data-bs-toggle="pill" data-bs-target="#questions-pane" type="button" role="tab" aria-controls="questions-pane" aria-selected="false">
            <i class="bi bi-patch-question me-1"></i> Контрольные вопросы
            @if (Model.IsControlQuestionsPassed)
            {
                <span class="badge bg-success ms-1"><i class="bi bi-check"></i></span>
            }
            else
            {
                <span class="badge bg-secondary ms-1">@Model.ControlQuestions.Count</span>
            }
        </button>
    </li>
    @if (Model.TestSummary != null)
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold" id="test-tab" data-bs-toggle="pill" data-bs-target="#test-pane" type="button" role="tab" aria-controls="test-pane" aria-selected="false">
                <i class="bi bi-ui-checks me-1"></i> Итоговый тест
                @if (Model.IsTestPassed)
                {
                    <span class="badge bg-success ms-1"><i class="bi bi-check"></i></span>
                }
                else
                {
                    <span class="badge bg-warning text-dark ms-1">@Model.TestSummary.PassingScorePercent%</span>
                }
            </button>
        </li>
    }
    @if (Model.RequiresReportSubmission)
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold position-relative" id="report-tab" data-bs-toggle="pill" data-bs-target="#report-pane" type="button" role="tab" aria-controls="report-pane" aria-selected="false">
                <i class="bi bi-file-earmark-arrow-up me-1"></i> Сдача отчёта
                @if (Model.IsReportApproved)
                {
                    <span class="badge bg-success ms-1"><i class="bi bi-check"></i></span>
                }
                else if (Model.CurrentReportSubmission != null && Model.CurrentReportSubmission.Status == ReportSubmissionStatus.Pending)
                {
                    <span class="badge bg-warning text-dark ms-1"><i class="bi bi-hourglass-split"></i></span>
                }
                else if (Model.CurrentReportSubmission != null && Model.CurrentReportSubmission.Status == ReportSubmissionStatus.NeedsRevision)
                {
                    <span class="badge bg-danger ms-1"><i class="bi bi-exclamation"></i></span>
                }
            </button>
        </li>
    }
</ul>

<div class="tab-content" id="lectureTabContent">
    <!-- 1. ТЕОРИЯ -->
    <div class="tab-pane fade show active" id="theory-pane" role="tabpanel" aria-labelledby="theory-tab" tabindex="0">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
            <span class="badge bg-light text-secondary border py-2 px-3">
                <i class="bi bi-clock me-1 text-primary"></i>~@readingMinutes мин на изучение материала
            </span>
            <button type="button" class="btn btn-outline-secondary btn-sm" id="zenModeBtn" onclick="toggleZenMode()" title="Скрыть меню и читать в полноэкранном режиме (Esc для выхода)">
                <i class="bi bi-arrows-fullscreen me-1"></i>Режим чтения
            </button>
        </div>

        @if (!string.IsNullOrEmpty(Model.AttachmentFilePath))
        {
            <div class="card bg-light border mb-4 zen-hide">
                <div class="card-body p-3">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-file-earmark-pdf-fill text-danger fs-3"></i>
                            <div>
                                <div class="fw-semibold">@Model.AttachmentOriginalName</div>
                                <div class="text-muted small">Официальный теоретический конспект к лекции</div>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <a asp-action="DownloadAttachment" asp-route-id="@Model.Id" target="_blank" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-box-arrow-up-right me-1"></i> Открыть в новой вкладке
                            </a>
                            <a asp-action="DownloadAttachment" asp-route-id="@Model.Id" download class="btn btn-primary btn-sm">
                                <i class="bi bi-download me-1"></i> Скачать файл
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="card shadow-sm border-0 mb-4 zen-reader-container">
            <div class="card-body p-4 p-lg-5 fs-6 lh-base text-break">
                @Html.Raw(Model.ContentHtml)
            </div>
        </div>

        <!-- Личные заметки студента к лекции -->
        <div class="card shadow-sm border-0 mb-4 zen-hide" style="border-left: 4px solid #f59e0b !important;">
            <div class="card-header py-2 px-3 d-flex justify-content-between align-items-center">
                <span class="fw-bold small text-body"><i class="bi bi-sticky-fill text-warning me-2"></i>Мои личные заметки к лекции</span>
                <span id="lectureNotesStatus" class="small text-muted"><i class="bi bi-check2 text-success me-1"></i>Сохраняется автоматически</span>
            </div>
            <div class="card-body p-3">
                <textarea id="lectureNotesArea" class="form-control" rows="3" placeholder="Запишите здесь важные тезисы, формулы, термины или вопросы к преподавателю... Заметки автоматически сохраняются в браузере."></textarea>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <a asp-action="Discipline" asp-route-id="@Model.DisciplineId" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> К списку тем
            </a>
            <button type="button" class="btn btn-primary" onclick="document.getElementById('questions-tab').click()">
                Перейти к контрольным вопросам <i class="bi bi-arrow-right ms-1"></i>
            </button>
        </div>
    </div>

    <!-- 2. КОНТРОЛЬНЫЕ ВОПРОСЫ -->
    <div class="tab-pane fade" id="questions-pane" role="tabpanel" aria-labelledby="questions-tab" tabindex="0">
        <div class="alert alert-info border shadow-sm mb-4">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-info-circle-fill fs-5"></i>
                <div>
                    Ответьте на все контрольные вопросы по материалу лекции. Для вопросов с выбором или вводом термина система выполняет автоматическую проверку сразу после отправки.
                </div>
            </div>
        </div>

        @if (!Model.ControlQuestions.Any())
        {
            <div class="card p-4 text-center text-muted">
                К этой лекции нет контрольных вопросов.
            </div>
        }
        else
        {
            <div class="d-grid gap-4">
                @foreach (var q in Model.ControlQuestions)
                {
                    <div class="card shadow-sm border-0" id="card-q-@q.Id">
                        <div class="card-header py-3 border-bottom d-flex justify-content-between align-items-center">
                            <span class="badge bg-secondary">Вопрос №@q.OrderIndex</span>
                            <span id="badge-status-@q.Id">
                                @if (q.IsAnswered)
                                {
                                    if (q.Type == QuestionType.OpenEnded)
                                    {
                                        if (q.IsReviewedByTeacher)
                                        {
                                            if (q.IsCorrect)
                                            {
                                                <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Зачтено преподавателем</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>На доработку</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>На проверке у преподавателя</span>
                                        }
                                    }
                                    else if (q.IsCorrect)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Верно</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Неверно</span>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border">Не отвечен</span>
                                }
                            </span>
                        </div>

                        <div class="card-body p-4">
                            <h6 class="fw-bold mb-3">@q.Text</h6>

                            @if (!string.IsNullOrEmpty(q.ImageUrl))
                            {
                                <div class="mb-3 text-start">
                                    <a href="@q.ImageUrl" target="_blank" class="test-img-zoom-btn text-decoration-none d-inline-block" onclick="openLectureImageModal('@q.ImageUrl'); return false;">
                                        <div class="position-relative d-inline-block rounded border p-1 bg-light shadow-sm">
                                            <img src="@q.ImageUrl" alt="Иллюстрация к вопросу" class="img-fluid rounded" style="max-height: 350px; max-width: 100%; object-fit: contain;" />
                                            <span class="badge bg-dark bg-opacity-75 position-absolute bottom-0 end-0 m-2">
                                                <i class="bi bi-zoom-in me-1"></i>Увеличить
                                            </span>
                                        </div>
                                    </a>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(q.Explanation))
                            {
                                <p class="text-muted small fst-italic mb-3"><i class="bi bi-lightbulb me-1"></i>@q.Explanation</p>
                            }

                            @if (q.Type == QuestionType.SingleChoice)
                            {
                                <div class="mb-3">
                                    @foreach (var opt in q.Options)
                                    {
                                        <div class="form-check mb-2">
                                            <input class="form-check-input" type="radio" name="cq_answer_@q.Id" id="opt_@opt.Id" value="@opt.Id" @(q.StudentGivenAnswer == opt.Id.ToString() ? "checked" : "") />
                                            <label class="form-check-label" for="opt_@opt.Id">
                                                @opt.Text
                                            </label>
                                        </div>
                                    }
                                </div>
                            }
                            else if (q.Type == QuestionType.MultipleChoice)
                            {
                                <div class="mb-3">
                                    @{
                                        var selectedIds = (q.StudentGivenAnswer ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries).ToHashSet();
                                    }
                                    @foreach (var opt in q.Options)
                                    {
                                        <div class="form-check mb-2">
                                            <input class="form-check-input mcq-opt-@q.Id" type="checkbox" id="opt_@opt.Id" value="@opt.Id" @(selectedIds.Contains(opt.Id.ToString()) ? "checked" : "") />
                                            <label class="form-check-label" for="opt_@opt.Id">
                                                @opt.Text
                                            </label>
                                        </div>
                                    }
                                </div>
                            }
                            else if (q.Type == QuestionType.ShortText || q.Type == QuestionType.FillBlank)
                            {
                                <div class="mb-3 col-md-8">
                                    <label class="form-label small text-muted">Ваш ответ:</label>
                                    <input type="text" id="text_answer_@q.Id" class="form-control" value="@q.StudentGivenAnswer" placeholder="Введите ответ..." />
                                </div>
                            }
                            else if (q.Type == QuestionType.Matching)
                            {
                                <div class="mb-3">
                                    <div class="row g-2">
                                        @{
                                            var targetKeys = q.Options.Select(o => o.MatchingKey).Where(k => !string.IsNullOrEmpty(k)).Distinct().ToList();
                                            // парсим сохраненный ответ: optId:val;optId2:val2
                                            var pairsDict = new Dictionary<int, string>();
                                            if (!string.IsNullOrEmpty(q.StudentGivenAnswer))
                                            {
                                                foreach (var pair in q.StudentGivenAnswer.Split(';'))
                                                {
                                                    var parts = pair.Split(':');
                                                    if (parts.Length == 2 && int.TryParse(parts[0], out int oid))
                                                    {
                                                        pairsDict[oid] = parts[1];
                                                    }
                                                }
                                            }
                                        }
                                        @foreach (var opt in q.Options)
                                        {
                                            <div class="col-md-6 mb-2">
                                                <div class="card p-2 bg-light border h-100">
                                                    <span class="small fw-semibold mb-1">@opt.Text:</span>
                                                    <select class="form-select form-select-sm matching-select-@q.Id" data-option-id="@opt.Id">
                                                        <option value="">-- Выберите соответствие --</option>
                                                        @foreach (var target in targetKeys)
                                                        {
                                                            bool isSel = pairsDict.TryGetValue(opt.Id, out var val) && val == target;
                                                            if (isSel)
                                                            {
                                                                <option value="@target" selected>@target</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@target">@target</option>
                                                            }
                                                        }
                                                    </select>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else if (q.Type == QuestionType.OpenEnded)
                            {
                                <div class="mb-3">
                                    <label class="form-label small text-muted">Развернутый ответ (проверяется преподавателем):</label>
                                    <textarea id="text_answer_@q.Id" class="form-control" rows="4" placeholder="Изложите ваш подробный ответ...">@q.StudentGivenAnswer</textarea>
                                </div>
                                @if (!string.IsNullOrEmpty(q.TeacherComment))
                                {
                                    <div class="alert alert-light border mt-2 small">
                                        <strong><i class="bi bi-chat-quote me-1"></i>Комментарий преподавателя:</strong> @q.TeacherComment
                                    </div>
                                }
                            }

                            <div class="d-flex align-items-center gap-2">
                                <button type="button" class="btn btn-outline-primary btn-sm" onclick="submitControlAnswer(@q.Id, '@q.Type')">
                                    <i class="bi bi-send me-1"></i> Отправить ответ
                                </button>
                                <span id="feedback_@q.Id" class="small fw-semibold"></span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- 3. ИТОГОВЫЙ ТЕСТ -->
    @if (Model.TestSummary != null)
    {
        <div class="tab-pane fade" id="test-pane" role="tabpanel" aria-labelledby="test-tab" tabindex="0">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-4 p-lg-5">
                    <div class="row align-items-center">
                        <div class="col-lg-8">
                            <span class="badge bg-primary mb-2">Контроль знаний</span>
                            <h4 class="fw-bold mb-2">@Model.TestSummary.Title</h4>
                            @if (!string.IsNullOrEmpty(Model.TestSummary.Description))
                            {
                                <p class="text-muted">@Model.TestSummary.Description</p>
                            }

                            <div class="row g-3 mt-2">
                                <div class="col-sm-4">
                                    <div class="p-3 bg-light rounded text-center">
                                        <div class="text-muted small">Проходной балл</div>
                                        <div class="fs-4 fw-bold text-primary">@Model.TestSummary.PassingScorePercent%</div>
                                    </div>
                                </div>
                                <div class="col-sm-4">
                                    <div class="p-3 bg-light rounded text-center">
                                        <div class="text-muted small">Осталось попыток</div>
                                        <div class="fs-4 fw-bold @(Model.TestSummary.AttemptsRemaining > 0 ? "text-success" : "text-danger")">
                                            @Model.TestSummary.AttemptsRemaining из @Model.TestSummary.MaxAttempts
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-4">
                                    <div class="p-3 bg-light rounded text-center">
                                        <div class="text-muted small">Лимит времени</div>
                                        <div class="fs-4 fw-bold text-body">
                                            @(Model.TestSummary.TimeLimitMinutes.HasValue ? $"{Model.TestSummary.TimeLimitMinutes.Value} мин" : "Без лимита")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4 mt-4 mt-lg-0 text-center text-lg-end">
                            @if (Model.TestSummary.IsPassed)
                            {
                                <div class="mb-3">
                                    <span class="badge bg-success p-3 fs-5 rounded-pill"><i class="bi bi-patch-check-fill me-2"></i>Тест успешно сдан!</span>
                                    <div class="small text-muted mt-2">Лучший результат: <strong>@Model.TestSummary.BestScorePercent%</strong></div>
                                </div>
                            }

                            @if (Model.TestSummary.CanTakeTest)
                            {
                                <a asp-action="TakeTest" asp-route-id="@Model.TestSummary.TestId" class="btn btn-primary btn-lg px-4 shadow-sm">
                                    <i class="bi bi-play-circle-fill me-2"></i> @(Model.TestSummary.AttemptsUsed > 0 ? "Пройти тест повторно" : "Начать тестирование")
                                </a>
                            }
                            else if (!Model.TestSummary.IsPassed)
                            {
                                <button class="btn btn-secondary btn-lg px-4" disabled>
                                    <i class="bi bi-slash-circle me-2"></i> Попытки исчерпаны
                                </button>
                                <div class="small text-danger mt-2">
                                    Обратитесь к преподавателю для сброса попыток.
                                </div>
                            }
                        </div>
                    </div>

                    <!-- История попыток -->
                    @if (Model.TestSummary.Attempts.Any())
                    {
                        <div class="mt-4 pt-4 border-top">
                            <h6 class="fw-bold mb-3"><i class="bi bi-clock-history me-2"></i>История ваших попыток:</h6>
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Попытка</th>
                                            <th>Дата и время</th>
                                            <th>Правильных ответов</th>
                                            <th>Итоговый процент</th>
                                            <th>Результат</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var att in Model.TestSummary.Attempts)
                                        {
                                            <tr>
                                                <td class="fw-bold">#@att.AttemptNumber</td>
                                                <td>@att.CompletedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                                <td>@att.CorrectQuestions из @att.TotalQuestions</td>
                                                <td class="fw-bold">@att.ScorePercent%</td>
                                                <td>
                                                    @if (att.IsPassed)
                                                    {
                                                        <span class="badge bg-success"><i class="bi bi-check-lg me-1"></i>СДАНО</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger"><i class="bi bi-x-lg me-1"></i>НЕ СДАНО</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- 4. СДАЧА ОТЧЕТА СТУДЕНТОМ -->
    @if (Model.RequiresReportSubmission)
    {
        <div class="tab-pane fade" id="report-pane" role="tabpanel" aria-labelledby="report-tab" tabindex="0">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-4 p-lg-5">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                        <div>
                            <span class="badge bg-primary mb-2">Практическая часть</span>
                            <h4 class="fw-bold mb-1">Сдача отчёта / практической работы</h4>
                            <div class="text-muted small">
                                Максимальная оценка: <strong>@(Model.MaxReportScore ?? 100) баллов</strong>
                            </div>
                        </div>

                        <div>
                            @if (Model.IsReportApproved)
                            {
                                <span class="badge bg-success p-2 px-3 fs-6">
                                    <i class="bi bi-check-circle-fill me-1"></i> Отчёт зачтен (@(Model.ReportGrade ?? 100)/@(Model.MaxReportScore ?? 100))
                                </span>
                            }
                            else if (Model.CurrentReportSubmission != null && Model.CurrentReportSubmission.Status == ReportSubmissionStatus.Pending)
                            {
                                <span class="badge bg-warning text-dark p-2 px-3 fs-6">
                                    <i class="bi bi-hourglass-split me-1"></i> На проверке у преподавателя
                                </span>
                            }
                            else if (Model.CurrentReportSubmission != null && Model.CurrentReportSubmission.Status == ReportSubmissionStatus.NeedsRevision)
                            {
                                <span class="badge bg-danger p-2 px-3 fs-6">
                                    <i class="bi bi-arrow-repeat me-1"></i> Требуется доработка
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary p-2 px-3 fs-6">
                                    <i class="bi bi-file-earmark-arrow-up me-1"></i> Ожидает отправки
                                </span>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.ReportInstructions))
                    {
                        <div class="alert alert-info border-info d-flex align-items-start gap-3 mb-4">
                            <i class="bi bi-info-circle-fill fs-4 flex-shrink-0 text-info"></i>
                            <div>
                                <h6 class="fw-bold mb-1">Требования преподавателя к отчёту:</h6>
                                <div style="white-space: pre-wrap;">@Model.ReportInstructions</div>
                            </div>
                        </div>
                    }

                    @if (Model.CurrentReportSubmission != null)
                    {
                        var rep = Model.CurrentReportSubmission;
                        string repExt = System.IO.Path.GetExtension(rep.OriginalFileName).ToLowerInvariant();
                        string repIcon = repExt switch
                        {
                            ".pdf" => "bi-file-earmark-pdf-fill text-danger",
                            ".doc" or ".docx" => "bi-file-earmark-word-fill text-primary",
                            ".xls" or ".xlsx" => "bi-file-earmark-excel-fill text-success",
                            ".zip" or ".rar" or ".7z" => "bi-file-earmark-zip-fill text-warning",
                            _ => "bi-file-earmark-text-fill text-secondary"
                        };

                        <div class="card bg-light border mb-4">
                            <div class="card-header py-3 bg-white border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
                                <span class="fw-bold">
                                    <i class="bi bi-cloud-check text-success me-1"></i> Текущая отправленная работа
                                </span>
                                <span class="text-muted small">
                                    <i class="bi bi-clock me-1"></i>Отправлено: @rep.SubmittedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </span>
                            </div>
                            <div class="card-body p-3">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <i class="bi @repIcon fs-1"></i>
                                        <div>
                                            <div class="fw-bold">@rep.OriginalFileName</div>
                                            <div class="text-muted small">
                                                Размер: @(rep.FileSizeBytes >= 1024 * 1024 ? $"{(rep.FileSizeBytes / (1024.0 * 1024.0)):F1} МБ" : $"{(rep.FileSizeBytes / 1024.0):F0} КБ")
                                            </div>
                                        </div>
                                    </div>
                                    <a asp-action="DownloadReport" asp-route-id="@rep.Id" class="btn btn-outline-primary btn-sm px-3">
                                        <i class="bi bi-download me-1"></i> Скачать отправленный файл
                                    </a>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(rep.StudentComment))
                                {
                                    <div class="mt-3 pt-3 border-top">
                                        <div class="text-muted small fw-semibold">Ваш комментарий к отправке:</div>
                                        <div class="small text-dark mt-1" style="white-space: pre-wrap;">@rep.StudentComment</div>
                                    </div>
                                }

                                @if (rep.ReviewedAt.HasValue)
                                {
                                    <div class="mt-3 p-3 bg-white rounded border">
                                        <div class="d-flex justify-content-between small text-muted mb-2">
                                            <span>
                                                <i class="bi bi-person-check-fill text-success me-1"></i>
                                                Проверено преподавателем: <strong>@(rep.ReviewedByTeacherName ?? "Преподаватель")</strong>
                                            </span>
                                            <span><i class="bi bi-calendar3 me-1"></i>@rep.ReviewedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                                        </div>

                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <span class="fw-bold">Оценка:</span>
                                            <span class="fs-5 fw-bold @(rep.Status == ReportSubmissionStatus.Approved ? "text-success" : "text-danger")">
                                                @(rep.Grade ?? 0) / @(Model.MaxReportScore ?? 100) баллов
                                            </span>
                                        </div>

                                        @if (!string.IsNullOrEmpty(rep.TeacherFeedback))
                                        {
                                            <div class="p-2 bg-light rounded small text-dark border">
                                                <strong>Замечания и рекомендации преподавателя:</strong>
                                                <div class="mt-1" style="white-space: pre-wrap;">@rep.TeacherFeedback</div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (!Model.IsReportApproved)
                    {
                        <div class="card border border-primary-subtle shadow-sm">
                            <div class="card-header py-3 bg-primary-subtle border-bottom">
                                <h6 class="fw-bold mb-0 text-primary">
                                    <i class="bi bi-upload me-2"></i>
                                    @(Model.CurrentReportSubmission != null ? "Загрузить исправленный отчёт" : "Загрузка отчёта на проверку")
                                </h6>
                            </div>
                            <div class="card-body p-4">
                                <form asp-action="SubmitReport" method="post" enctype="multipart/form-data">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="lectureId" value="@Model.Id" />

                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">
                                            Выберите файл работы (PDF, DOCX, XLSX, ZIP, RAR, код):
                                        </label>
                                        <input type="file" name="reportFile" class="form-control" required
                                               accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.zip,.rar,.7z,.txt,.rtf,.py,.cs,.cpp,.java,.html,.css,.js,.sql" />
                                        <div class="form-text small text-muted">
                                            Максимальный размер файла: 50 МБ.
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Комментарий или пояснение (необязательно):</label>
                                        <textarea name="studentComment" class="form-control" rows="2" placeholder="Например: Выполнил задания 1-4, во вложении полный отчет и архив с исходниками..."></textarea>
                                    </div>

                                    <button type="submit" class="btn btn-primary px-4 fw-semibold">
                                        <i class="bi bi-send-fill me-1"></i>
                                        @(Model.CurrentReportSubmission != null ? "Отправить исправленный вариант" : "Отправить отчёт на проверку")
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- Нижняя панель навигации между лекциями -->
<div class="craft-card mt-4 p-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <a asp-action="Discipline" asp-route-id="@Model.DisciplineId" class="btn btn-outline-secondary">
            <i class="bi bi-grid me-1"></i> К списку лекций
        </a>

        @if (Model.NextLectureId.HasValue)
        {
            if (Model.CanOpenNextLecture)
            {
                <a asp-action="Lecture" asp-route-id="@Model.NextLectureId.Value" class="btn btn-success fw-semibold">
                    Перейти к следующей лекции <i class="bi bi-arrow-right-circle-fill ms-1"></i>
                </a>
            }
            else
            {
                <button class="btn btn-outline-secondary" disabled title="Следующая лекция откроется только после выполнения заданий и успешной сдачи теста">
                    <i class="bi bi-lock-fill me-1"></i> Следующая лекция заблокирована
                </button>
            }
        }
        else
        {
            <span class="badge bg-success p-2"><i class="bi bi-check2-all me-1"></i> Это заключительная лекция дисциплины</span>
        }
    </div>
</div>

<!-- Модальное окно для полноразмерного просмотра иллюстрации контрольного вопроса -->
<div class="modal fade" id="lectureImageZoomModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content border-0 bg-transparent">
            <div class="modal-header border-0 pb-0 justify-content-end">
                <button type="button" class="btn btn-dark btn-sm rounded-circle shadow" data-bs-dismiss="modal" aria-label="Закрыть">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body p-2 text-center">
                <img id="lectureZoomedModalImage" src="" alt="Увеличенное изображение" class="img-fluid rounded shadow-lg bg-white p-1" style="max-height: 85vh; object-fit: contain;" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function submitControlAnswer(questionId, qType) {
            let answer = "";

            if (qType === "SingleChoice") {
                const selected = document.querySelector(`input[name="cq_answer_${questionId}"]:checked`);
                if (!selected) {
                    alert("Пожалуйста, выберите вариант ответа");
                    return;
                }
                answer = selected.value;
            } else if (qType === "MultipleChoice") {
                const checked = Array.from(document.querySelectorAll(`.mcq-opt-${questionId}:checked`)).map(cb => cb.value);
                if (checked.length === 0) {
                    alert("Пожалуйста, выберите хотя бы один вариант ответа");
                    return;
                }
                answer = checked.join(",");
            } else if (qType === "ShortText" || qType === "FillBlank" || qType === "OpenEnded") {
                const input = document.getElementById(`text_answer_${questionId}`);
                if (!input || !input.value.trim()) {
                    alert("Пожалуйста, введите текст ответа");
                    return;
                }
                answer = input.value.trim();
            } else if (qType === "Matching") {
                const selects = document.querySelectorAll(`.matching-select-${questionId}`);
                const pairs = [];
                let allChosen = true;
                selects.forEach(s => {
                    if (!s.value) allChosen = false;
                    pairs.push(`${s.dataset.optionId}:${s.value}`);
                });
                if (!allChosen) {
                    alert("Пожалуйста, установите соответствия для всех пунктов");
                    return;
                }
                answer = pairs.join(";");
            }

            const feedbackEl = document.getElementById(`feedback_${questionId}`);
            const badgeStatus = document.getElementById(`badge-status-${questionId}`);
            feedbackEl.innerText = "Проверка...";

            const formData = new FormData();
            formData.append("questionId", questionId);
            formData.append("answer", answer);

            // Получаем AntiForgery токен
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";

            try {
                const resp = await fetch('@Url.Action("SubmitControlAnswer", "Student")', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    },
                    body: formData
                });

                const data = await resp.json();

                if (!data.success) {
                    feedbackEl.innerText = data.message || "Ошибка отправки";
                    feedbackEl.className = "small fw-semibold text-danger";
                    return;
                }

                if (data.isOpenEnded) {
                    feedbackEl.innerText = "✓ Ответ сохранен и направлен преподавателю на проверку";
                    feedbackEl.className = "small fw-semibold text-primary";
                    badgeStatus.innerHTML = '<span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>На проверке у преподавателя</span>';
                } else if (data.isCorrect) {
                    feedbackEl.innerText = "✓ Верно!";
                    feedbackEl.className = "small fw-semibold text-success";
                    badgeStatus.innerHTML = '<span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Верно</span>';
                } else {
                    feedbackEl.innerText = "✗ " + (data.feedback || "Неверно, попробуйте еще раз");
                    feedbackEl.className = "small fw-semibold text-danger";
                    badgeStatus.innerHTML = '<span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Неверно</span>';
                }

                if (data.isLectureCompleted) {
                    alert("Поздравляем! Все задания по лекции выполнены, следующая лекция разблокирована.");
                    location.reload();
                }

            } catch (err) {
                feedbackEl.innerText = "Ошибка соединения с сервером";
                feedbackEl.className = "small fw-semibold text-danger";
            }
        }

        function openLectureImageModal(url) {
            document.getElementById('lectureZoomedModalImage').src = url;
            const modal = new bootstrap.Modal(document.getElementById('lectureImageZoomModal'));
            modal.show();
        }

        document.addEventListener('DOMContentLoaded', function () {
            if (window.initReadingProgressBar) window.initReadingProgressBar();
            if (window.initLectureNotes) window.initLectureNotes(@Model.Id, '@(User.Identity?.Name ?? "guest")');
        });
    </script>
}

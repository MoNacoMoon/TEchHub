@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Восстановление пароля";
}

<div class="row justify-content-center align-items-center py-4 g-4">
    <div class="col-lg-5 col-md-7">
        <div class="craft-card p-4 p-md-5">
            <div class="d-flex align-items-center gap-3 mb-4">
                <span class="brand-logo-wrapper" style="width: 44px; height: 44px;">
                    <img src="~/images/logo-dark.jpg" class="brand-logo-img logo-theme-dark" alt="TechHub" style="width: 44px; height: 44px; border-radius: 10px;" />
                    <img src="~/images/logo-light.jpg" class="brand-logo-img logo-theme-light" alt="TechHub" style="width: 44px; height: 44px; border-radius: 10px;" />
                </span>
                <div>
                    <h4 class="mb-0 fw-bold">Восстановление пароля</h4>
                    <span class="text-muted small">Образовательная платформа TechHub</span>
                </div>
            </div>

            <p class="text-muted small mb-4">
                Введите адрес электронной почты или логин, указанный при регистрации. Мы вышлем вам 6-значный код для сброса пароля.
            </p>

            <form asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                <div class="mb-4">
                    <label asp-for="EmailOrUsername" class="form-label fw-semibold">Email или логин</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person-bounding-box"></i></span>
                        <input asp-for="EmailOrUsername" 
                               class="form-control" 
                               placeholder="student@mail.ru или ivanov_ii" 
                               autofocus 
                               required />
                    </div>
                    <span asp-validation-for="EmailOrUsername" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 d-flex align-items-center justify-content-center gap-2 mb-3">
                    <i class="bi bi-send-fill"></i>
                    <span>Отправить код для сброса</span>
                </button>
            </form>

            <div class="p-3 bg-body-tertiary rounded-3 border small text-muted mb-3">
                <div class="d-flex gap-2">
                    <i class="bi bi-info-circle text-primary fs-5 flex-shrink-0"></i>
                    <div>
                        <strong>Забыли логин или нет доступа к почте?</strong><br />
                        Ваш преподаватель может сбросить пароль или подтвердить учетную запись в журнале группы за 1 клик.
                    </div>
                </div>
            </div>

            <div class="text-center pt-3 border-top text-muted small">
                <span>Вспомнили пароль?</span>
                <a asp-action="Login" class="ms-1 fw-semibold text-primary text-decoration-none">Вернуться ко входу</a>
            </div>
        </div>
    </div>
</div>

@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Сброс пароля";
}

<div class="row justify-content-center align-items-center py-4 g-4">
    <div class="col-lg-5 col-md-7">
        <div class="craft-card p-4 p-md-5">
            <div class="d-flex align-items-center gap-3 mb-4">
                <span class="brand-logo-wrapper" style="width: 44px; height: 44px;">
                    <img src="~/images/logo-dark.jpg" class="brand-logo-img logo-theme-dark" alt="TechHub" style="width: 44px; height: 44px; border-radius: 10px;" />
                    <img src="~/images/logo-light.jpg" class="brand-logo-img logo-theme-light" alt="TechHub" style="width: 44px; height: 44px; border-radius: 10px;" />
                </span>
                <div>
                    <h4 class="mb-0 fw-bold">Новый пароль</h4>
                    <span class="text-muted small">Восстановление доступа в TechHub</span>
                </div>
            </div>

            <p class="text-muted small mb-3">
                Введите 6-значный код из письма, отправленного на <strong class="text-body font-mono">@Model.Email</strong>, и укажите новый пароль.
            </p>

            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Email" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Code" class="form-label d-flex justify-content-between">
                        <span class="fw-semibold">Код подтверждения (6 цифр)</span>
                        <span class="text-muted small">Из письма</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-key"></i></span>
                        <input asp-for="Code" 
                               class="form-control text-center font-mono fw-bold fs-4" 
                               maxlength="6" 
                               placeholder="123456" 
                               inputmode="numeric" 
                               pattern="[0-9]{6}" 
                               style="letter-spacing: 6px;"
                               autofocus 
                               required />
                    </div>
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label fw-semibold">Новый пароль</label>
                    <input asp-for="NewPassword" type="password" class="form-control" placeholder="Не менее 6 знаков" required />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmNewPassword" class="form-label fw-semibold">Подтверждение нового пароля</label>
                    <input asp-for="ConfirmNewPassword" type="password" class="form-control" placeholder="Повторите новый пароль" required />
                    <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 d-flex align-items-center justify-content-center gap-2 mb-3">
                    <i class="bi bi-check2-circle"></i>
                    <span>Сохранить пароль и войти</span>
                </button>
            </form>

            <div class="text-center pt-3 border-top text-muted small">
                <span>Отменить восстановление?</span>
                <a asp-action="Login" class="ms-1 fw-semibold text-primary text-decoration-none">Вернуться ко входу</a>
            </div>
        </div>
    </div>
</div>

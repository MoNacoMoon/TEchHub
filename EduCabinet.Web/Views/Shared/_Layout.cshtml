<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechHub</title>
    <!-- Локальные проверенные стили Bootstrap 5 и Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <!-- Современные шрифты Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Фавикон вкладки браузера TechHub (поддержка динамической смены темы) -->
    <link id="appFavicon" rel="icon" type="image/png" sizes="64x64" href="~/favicon.png" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
    <!-- Применение темы до отрисовки DOM для устранения мерцания -->
    <script>
        (function() {
            try {
                var saved = localStorage.getItem('educabinet_theme') || 
                    (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                document.documentElement.setAttribute('data-bs-theme', saved);
                document.documentElement.setAttribute('data-theme', saved);
                var fav = document.getElementById('appFavicon');
                if (fav) {
                    fav.href = (saved === 'light') ? '/favicon-light.png' : '/favicon.png';
                }
            } catch(e) {}
        })();
    </script>
</head>
<body>
    <header class="app-header">
        <div class="top-bar-inner">
            <div class="d-flex align-items-center">
                <!-- Бренд и логотип платформы TechHub -->
                <a class="brand-mark d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="brand-logo-wrapper">
                        <img src="~/images/logo-dark.jpg" class="brand-logo-img logo-theme-dark" alt="TechHub" />
                        <img src="~/images/logo-light.jpg" class="brand-logo-img logo-theme-light" alt="TechHub" />
                    </span>
                    <span class="brand-name fw-bold fs-5 tracking-tight">TechHub</span>
                </a>

                <!-- Навигация ролей -->
                <nav class="nav-links-group d-none d-md-flex align-items-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        if (User.IsInRole("Teacher") || User.IsInRole("Admin"))
                        {
                            <a class="top-nav-link" asp-controller="Teacher" asp-action="Index">Панель</a>
                            <a class="top-nav-link" asp-controller="Teacher" asp-action="Disciplines">Дисциплины</a>
                            <a class="top-nav-link" asp-controller="Teacher" asp-action="StudentReports">Отчёты</a>
                            <a class="top-nav-link" asp-controller="Teacher" asp-action="ManualReviews">Проверка</a>
                            <a class="top-nav-link" asp-controller="Teacher" asp-action="Reports">Журнал</a>
                            <a class="top-nav-link" asp-controller="Teacher" asp-action="Students">Студенты</a>
                            <a class="top-nav-link" asp-controller="Teacher" asp-action="AuditLog">Аудит</a>
                            <a class="top-nav-link" asp-controller="Teacher" asp-action="Backup">Бэкап</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a class="top-nav-link" asp-controller="Teacher" asp-action="StaffInvites">Инвайты</a>
                            }
                        }
                        else if (User.IsInRole("Student"))
                        {
                            <a class="top-nav-link" asp-controller="Student" asp-action="Index">Дисциплины</a>
                            <a class="top-nav-link" asp-controller="Student" asp-action="MyReports">Мои отчёты</a>
                            <a class="top-nav-link" asp-controller="Student" asp-action="Gradebook">Зачётка</a>
                        }
                    }
                </nav>
            </div>

            <!-- Правая часть: Command Palette, Тема, Профиль -->
            <div class="d-flex align-items-center gap-2">
                <!-- Быстрый поиск Command Palette (Ctrl+K) -->
                <button type="button" class="top-search-btn" onclick="openCommandPalette()" title="Быстрый поиск (Ctrl + K)">
                    <i class="bi bi-search"></i>
                    <span class="d-none d-lg-inline">Поиск</span>
                    <kbd class="key-badge">Ctrl K</kbd>
                </button>

                <!-- Переключатель темы (Луна 🌙 <-> Солнце ☀️) -->
                <button type="button" id="themeToggleBtn" onclick="toggleAppTheme(event)" class="theme-switch-btn" title="Сменить тему оформления" aria-label="Сменить тему оформления">
                    <span class="theme-icon-track" aria-hidden="true">
                        <!-- Сияющий полумесяц со звездами для темной темы -->
                        <span class="theme-icon theme-icon-moon" title="Тёмная тема">
                            <svg class="moon-svg" viewBox="0 0 24 24" width="18" height="18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" fill="url(#moonGradSky)" stroke="#38bdf8" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M19 2.5v3M17.5 4h3" stroke="#a5f3fc" stroke-width="1.2" stroke-linecap="round" />
                                <circle cx="21" cy="8.5" r="0.8" fill="#bae6fd" />
                                <defs>
                                    <linearGradient id="moonGradSky" x1="10" y1="3" x2="21" y2="21" gradientUnits="userSpaceOnUse">
                                        <stop stop-color="#38bdf8" />
                                        <stop offset="100%" stop-color="#818cf8" />
                                    </linearGradient>
                                </defs>
                            </svg>
                        </span>
                        <!-- Сияющее солнце для светлой темы -->
                        <span class="theme-icon theme-icon-sun" title="Светлая тема">
                            <svg class="sun-svg" viewBox="0 0 24 24" width="18" height="18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="12" cy="12" r="4.5" fill="url(#sunGradWarm)" stroke="#ea580c" stroke-width="1" />
                                <g stroke="#d97706" stroke-width="1.8" stroke-linecap="round">
                                    <line x1="12" y1="2" x2="12" y2="4.5" />
                                    <line x1="12" y1="19.5" x2="12" y2="22" />
                                    <line x1="2" y1="12" x2="4.5" y2="12" />
                                    <line x1="19.5" y1="12" x2="22" y2="12" />
                                    <line x1="4.93" y1="4.93" x2="6.7" y2="6.7" />
                                    <line x1="17.3" y1="17.3" x2="19.07" y2="19.07" />
                                    <line x1="4.93" y1="19.07" x2="6.7" y2="17.3" />
                                    <line x1="17.3" y1="6.7" x2="19.07" y2="4.93" />
                                </g>
                                <defs>
                                    <radialGradient id="sunGradWarm" cx="10" cy="10" r="8" gradientUnits="userSpaceOnUse">
                                        <stop offset="0%" stop-color="#fef08a" />
                                        <stop offset="55%" stop-color="#f59e0b" />
                                        <stop offset="100%" stop-color="#d97706" />
                                    </radialGradient>
                                </defs>
                            </svg>
                        </span>
                    </span>
                    <span class="d-none d-sm-inline font-mono" id="themeLabel" style="font-size: 0.8rem;"></span>
                </button>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <!-- Центр интерактивных уведомлений («Колокольчик») -->
                    <div class="dropdown notification-dropdown" id="notificationDropdownContainer">
                        <button type="button" class="btn-notification-bell" id="notificationBellBtn" data-bs-toggle="dropdown" aria-expanded="false" title="Уведомления">
                            <i class="bi bi-bell-fill"></i>
                            <span class="notification-badge d-none" id="notificationBadge">0</span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end shadow-lg p-0 notification-menu" aria-labelledby="notificationBellBtn">
                            <div class="d-flex justify-content-between align-items-center p-3 border-bottom">
                                <div class="fw-bold d-flex align-items-center gap-2">
                                    <i class="bi bi-bell text-primary"></i>
                                    <span>Уведомления</span>
                                    <span class="badge bg-primary-subtle text-primary rounded-pill small" id="notificationHeaderCount">0</span>
                                </div>
                                <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 text-muted" id="markAllReadBtn" onclick="markAllNotificationsAsRead(event)">
                                    <i class="bi bi-check2-all me-1"></i>Прочитать все
                                </button>
                            </div>
                            <div class="notification-list" id="notificationList" style="max-height: 380px; overflow-y: auto;">
                                <div class="text-center py-4 text-muted small" id="notificationEmpty">
                                    <i class="bi bi-bell-slash fs-3 d-block mb-1 opacity-50"></i>
                                    Нет новых уведомлений
                                </div>
                            </div>
                        </div>
                    </div>

                    string userName = User.FindFirst("FullName")?.Value ?? User.Identity.Name ?? "Пользователь";
                    string userInitials = "ПК";
                    var nameParts = userName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                    if (nameParts.Length >= 2) { userInitials = $"{nameParts[0][0]}{nameParts[1][0]}".ToUpper(); }
                    else if (nameParts.Length == 1 && nameParts[0].Length >= 2) { userInitials = nameParts[0].Substring(0, 2).ToUpper(); }

                    <div class="user-identity">
                        <span class="user-avatar-pill" title="@userName">@userInitials</span>
                        <span class="d-none d-sm-inline font-mono text-muted" style="font-size: 0.78rem;">
                            @(User.IsInRole("Teacher") ? "Преподаватель" : (User.FindFirst("GroupName")?.Value ?? "Студент"))
                        </span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0 p-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-logout-icon" title="Завершить сеанс">
                                <i class="bi bi-box-arrow-right"></i>
                            </button>
                        </form>
                    </div>

                    <!-- Кнопка мобильного меню (Offcanvas Drawer для телефонов) -->
                    <button class="btn btn-sm btn-outline-secondary d-md-none mobile-nav-btn p-1 px-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNavDrawer" aria-controls="mobileNavDrawer" aria-label="Открыть мобильное меню">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                }
                else
                {
                    <a class="btn btn-secondary btn-sm px-2 px-sm-3" asp-controller="Account" asp-action="Login">Войти</a>
                    <a class="btn btn-primary btn-sm px-2 px-sm-3" asp-controller="Account" asp-action="Register">Регистрация</a>
                }
            </div>
        </div>
    </header>

    <main class="main-content">
        <div class="main-wrapper">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
                    <i class="bi bi-check-circle-fill text-success"></i>
                    <div>@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close ms-auto shadow-none" data-bs-dismiss="alert" aria-label="Закрыть"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill text-danger"></i>
                    <div>@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close ms-auto shadow-none" data-bs-dismiss="alert" aria-label="Закрыть"></button>
                </div>
            }

            @RenderBody()
        </div>
    </main>

    <!-- Диалоговое окно Command Palette (Ctrl + K) -->
    <div class="modal fade" id="commandPaletteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered command-palette-dialog">
            <div class="modal-content command-palette-content">
                <div class="p-2 border-bottom d-flex align-items-center gap-2 px-3">
                    <i class="bi bi-search text-muted"></i>
                    <input type="text" id="commandPaletteSearch" class="command-palette-input" placeholder="Поиск по дисциплинам и разделам... (Esc для выхода)" autocomplete="off">
                    <kbd class="key-badge">Esc</kbd>
                </div>
                <div class="p-2" id="commandPaletteResults" style="max-height: 340px; overflow-y: auto;">
                    <!-- Заполняется динамически из site.js -->
                </div>
                <div class="p-2 px-3 border-top d-flex justify-content-between align-items-center text-muted" style="font-size: 0.74rem;">
                    <span><kbd class="key-badge me-1">↑</kbd><kbd class="key-badge me-1">↓</kbd> Навигация</span>
                    <span><kbd class="key-badge me-1">Enter</kbd> Выбрать</span>
                    <span class="font-mono">ЭУК Платформа</span>
                </div>
            </div>
        </div>
    </div>

    <footer class="app-footer">
        <div class="footer-inner d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <span>&copy; @DateTime.Now.Year TechHub • Образовательная платформа</span>
            </div>
            <div class="text-muted font-mono" style="font-size: 0.74rem;">
                <span>TechHub</span>
            </div>
        </div>
    </footer>

    <!-- Мобильная шторка навигации (Offcanvas Drawer для смартфонов и планшетов) -->
    <div class="offcanvas offcanvas-end mobile-offcanvas" tabindex="-1" id="mobileNavDrawer" aria-labelledby="mobileNavDrawerLabel">
        <div class="offcanvas-header border-bottom">
            <div class="d-flex align-items-center gap-2">
                <span class="brand-logo-wrapper">
                    <img src="~/images/logo-dark.jpg" class="brand-logo-img logo-theme-dark" style="height: 30px; width: 30px;" alt="TechHub" />
                    <img src="~/images/logo-light.jpg" class="brand-logo-img logo-theme-light" style="height: 30px; width: 30px;" alt="TechHub" />
                </span>
                <span class="fw-bold fs-5" id="mobileNavDrawerLabel">TechHub</span>
            </div>
            <button type="button" class="btn-close text-reset shadow-none" data-bs-dismiss="offcanvas" aria-label="Закрыть"></button>
        </div>
        <div class="offcanvas-body p-3 d-flex flex-column justify-content-between">
            <div>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    string mUser = User.FindFirst("FullName")?.Value ?? User.Identity.Name ?? "Пользователь";
                    string mInitials = "ПК";
                    var mParts = mUser.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                    if (mParts.Length >= 2) { mInitials = $"{mParts[0][0]}{mParts[1][0]}".ToUpper(); }
                    else if (mParts.Length == 1 && mParts[0].Length >= 2) { mInitials = mParts[0].Substring(0, 2).ToUpper(); }

                    <!-- Карточка пользователя в мобильном меню -->
                    <div class="p-3 mb-3 rounded-3" style="background: var(--bg-surface-raised); border: 1px solid var(--hairline);">
                        <div class="d-flex align-items-center gap-3">
                            <span class="user-avatar-pill" style="width: 36px; height: 36px; font-size: 0.95rem;">@mInitials</span>
                            <div class="text-truncate">
                                <div class="fw-bold text-truncate" style="font-size: 0.9rem;">@mUser</div>
                                <span class="quiet-tag font-mono small">
                                    @(User.IsInRole("Teacher") ? "Преподаватель" : (User.FindFirst("GroupName")?.Value ?? "Студент"))
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Навигационные ссылки для мобильного устройства -->
                    <div class="list-group list-group-flush rounded-3 border mb-3 overflow-hidden">
                        @if (User.IsInRole("Teacher") || User.IsInRole("Admin"))
                        {
                            <a class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-2 px-3" asp-controller="Teacher" asp-action="Index">
                                <i class="bi bi-speedometer2 text-primary fs-5"></i>
                                <span>Панель управления</span>
                            </a>
                            <a class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-2 px-3" asp-controller="Teacher" asp-action="Disciplines">
                                <i class="bi bi-journal-bookmark text-primary fs-5"></i>
                                <span>Дисциплины и курсы</span>
                            </a>
                            <a class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-2 px-3" asp-controller="Teacher" asp-action="Students">
                                <i class="bi bi-people-fill text-success fs-5"></i>
                                <span>Учебные группы (1–4)</span>
                            </a>
                            <a class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-2 px-3" asp-controller="Teacher" asp-action="Reports">
                                <i class="bi bi-file-earmark-spreadsheet text-info fs-5"></i>
                                <span>Сводный журнал</span>
                            </a>
                            <a class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-2 px-3" asp-controller="Teacher" asp-action="StudentReports">
                                <i class="bi bi-folder-check text-primary fs-5"></i>
                                <span>Проверка отчётов студентов</span>
                            </a>
                            <a class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-2 px-3" asp-controller="Teacher" asp-action="ManualReviews">
                                <i class="bi bi-check2-square text-warning fs-5"></i>
                                <span>Проверка ответов и эссе</span>
                            </a>
                            <a class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-2 px-3" asp-controller="Teacher" asp-action="AuditLog">
                                <i class="bi bi-shield-check text-secondary fs-5"></i>
                                <span>Журнал аудита</span>
                            </a>
                            <a class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-2 px-3" asp-controller="Teacher" asp-action="Backup">
                                <i class="bi bi-database-down text-secondary fs-5"></i>
                                <span>Резервные копии</span>
                            </a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-2 px-3" asp-controller="Teacher" asp-action="StaffInvites">
                                    <i class="bi bi-person-badge-fill text-danger fs-5"></i>
                                    <span>Инвайты преподавателей</span>
                                </a>
                            }
                        }
                        else if (User.IsInRole("Student"))
                        {
                            <a class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-2 px-3" asp-controller="Student" asp-action="Index">
                                <i class="bi bi-mortarboard-fill text-primary fs-5"></i>
                                <span>Мои дисциплины</span>
                            </a>
                            <a class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-2 px-3" asp-controller="Student" asp-action="MyReports">
                                <i class="bi bi-folder-check text-warning fs-5"></i>
                                <span>Мои отчёты и задания</span>
                            </a>
                            <a class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-2 px-3" asp-controller="Student" asp-action="Gradebook">
                                <i class="bi bi-journal-check text-success fs-5"></i>
                                <span>Электронная зачётка</span>
                            </a>
                        }
                    </div>
                }
            </div>

            <!-- Нижняя часть мобильного меню -->
            <div class="pt-3 border-top mt-auto">
                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-secondary d-flex align-items-center justify-content-center gap-2 py-2" onclick="toggleAppTheme(event)">
                        <i class="bi bi-circle-half"></i>
                        <span id="mobileThemeLabel">Сменить тему оформления</span>
                    </button>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger w-100 d-flex align-items-center justify-content-center gap-2 py-2">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Выйти из аккаунта</span>
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Локальные проверенные скрипты Bootstrap 5 и модулей -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
